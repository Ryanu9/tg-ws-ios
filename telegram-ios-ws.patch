diff --git a/submodules/TelegramCore/Sources/WsBridge/WsLocalAccount.swift b/submodules/TelegramCore/Sources/WsBridge/WsLocalAccount.swift
new file mode 100644
index 00000000..ebed0f41
--- /dev/null
+++ b/submodules/TelegramCore/Sources/WsBridge/WsLocalAccount.swift
@@ -0,0 +1,199 @@
+import Foundation
+import Postbox
+import SwiftSignalKit
+
+/// "Local WS mode": the app runs without a Telegram cloud account. A local-only self user is
+/// installed so the app skips the login screens and opens the native chat list directly.
+/// The network of this account is never resumed (see `Account.init`), so no request ever reaches
+/// Telegram servers and nothing can log it out. Messages received by the WebSocket bridge are
+/// written straight into Postbox as broadcast-channel posts, so the chat list, chat bubbles,
+/// photo viewer, unread counters and the app badge all work natively.
+public enum WsLocalAccount {
+    public static let peerId: EnginePeer.Id = PeerId(namespace: Namespaces.Peer.CloudUser, id: PeerId.Id._internalFromInt64Value(6999999999))
+
+    public static func isLocal(_ peerId: EnginePeer.Id) -> Bool {
+        return peerId == WsLocalAccount.peerId
+    }
+
+    /// Drives the "Connecting..." / "Waiting for network..." title of the local account.
+    public static let networkState = ValuePromise<AccountNetworkState>(.online(proxy: nil), ignoreRepeated: true)
+
+    private static let localModeKey = "wsbridge.local_mode"
+
+    /// When enabled, a fresh install converts its first (unauthorized) account into the local account.
+    public static var isLocalModeEnabled: Bool {
+        get {
+            return (UserDefaults.standard.object(forKey: WsLocalAccount.localModeKey) as? Bool) ?? true
+        }
+        set {
+            UserDefaults.standard.set(newValue, forKey: WsLocalAccount.localModeKey)
+        }
+    }
+
+    /// Turns an unauthorized account into the local-only account (no Telegram login).
+    public static func activate(account: UnauthorizedAccount, accountManager: AccountManager<TelegramAccountManagerTypes>) -> Signal<Void, NoError> {
+        let user = TelegramUser(id: WsLocalAccount.peerId, accessHash: nil, firstName: "WS", lastName: "本地模式", username: nil, phone: nil, photo: [], botInfo: nil, restrictionInfo: nil, flags: [], emojiStatus: nil, usernames: [], storiesHidden: nil, nameColor: nil, backgroundEmojiId: nil, profileColor: nil, profileBackgroundEmojiId: nil, subscriberCount: nil, verificationIconFileId: nil)
+        let appVersion = account.networkArguments.appVersion
+        let testingEnvironment = account.testingEnvironment
+        let masterDatacenterId = account.masterDatacenterId
+        return account.postbox.transaction { transaction -> Void in
+            updatePeersCustom(transaction: transaction, peers: [user], update: { _, updated in
+                return updated
+            })
+            initializedAppSettingsAfterLogin(transaction: transaction, appVersion: appVersion, syncContacts: false)
+            WsLocalAccount.removeChatListHoles(transaction: transaction)
+            transaction.setState(AuthorizedAccountState(isTestingEnvironment: testingEnvironment, masterDatacenterId: masterDatacenterId, peerId: user.id, state: nil, invalidatedChannels: []))
+        }
+        |> mapToSignal { _ -> Signal<Void, NoError> in
+            return accountManager.transaction { transaction -> Void in
+                switchToAuthorizedAccount(transaction: transaction, account: account, isSupportUser: false)
+            }
+        }
+    }
+
+    /// A fresh account starts with a chat list "hole" that is filled from the server. The local
+    /// account has no server, so the hole would keep the chat list loading forever.
+    static func removeChatListHoles(transaction: Transaction) {
+        let seedIndex = MessageIndex(id: MessageId(peerId: PeerId(namespace: Namespaces.Peer.Empty, id: PeerId.Id._internalFromInt64Value(0)), namespace: Namespaces.Message.Cloud, id: 1), timestamp: Int32.max - 1)
+        for groupId in [PeerGroupId.root, Namespaces.PeerGroup.archive] {
+            transaction.replaceChatListHole(groupId: groupId, index: seedIndex, hole: nil)
+            for hole in transaction.allChatListHoles(groupId: groupId) {
+                transaction.replaceChatListHole(groupId: groupId, index: hole.index, hole: nil)
+            }
+        }
+    }
+
+    // MARK: - Ingest
+
+    public struct Image {
+        public var data: Data
+        public var width: Int32
+        public var height: Int32
+        public var thumbnailData: Data?
+        public var thumbnailWidth: Int32
+        public var thumbnailHeight: Int32
+
+        public init(data: Data, width: Int32, height: Int32, thumbnailData: Data?, thumbnailWidth: Int32, thumbnailHeight: Int32) {
+            self.data = data
+            self.width = width
+            self.height = height
+            self.thumbnailData = thumbnailData
+            self.thumbnailWidth = thumbnailWidth
+            self.thumbnailHeight = thumbnailHeight
+        }
+    }
+
+    public struct Post {
+        /// Local channel id (see `channelPeerId`).
+        public var channelId: Int64
+        public var channelTitle: String
+        /// Show `postAuthor` as the post signature.
+        public var signatures: Bool
+        public var timestamp: Int32
+        public var text: String
+        public var entities: [MessageTextEntity]
+        public var postAuthor: String?
+        public var images: [Image]
+
+        public init(channelId: Int64, channelTitle: String, signatures: Bool, timestamp: Int32, text: String, entities: [MessageTextEntity], postAuthor: String?, images: [Image]) {
+            self.channelId = channelId
+            self.channelTitle = channelTitle
+            self.signatures = signatures
+            self.timestamp = timestamp
+            self.text = text
+            self.entities = entities
+            self.postAuthor = postAuthor
+            self.images = images
+        }
+    }
+
+    public static func channelPeerId(_ channelId: Int64) -> EnginePeer.Id {
+        return PeerId(namespace: Namespaces.Peer.CloudChannel, id: PeerId.Id._internalFromInt64Value(channelId))
+    }
+
+    /// Writes posts into the local account's Postbox, creating/renaming the local channels as needed.
+    public static func ingest(account: Account, posts: [Post]) -> Signal<Void, NoError> {
+        if posts.isEmpty || !WsLocalAccount.isLocal(account.peerId) {
+            return .complete()
+        }
+        let postbox = account.postbox
+
+        var prepared: [(Post, [TelegramMediaImage])] = []
+        for post in posts {
+            var media: [TelegramMediaImage] = []
+            for image in post.images {
+                var representations: [TelegramMediaImageRepresentation] = []
+                if let thumbnailData = image.thumbnailData {
+                    let resource = LocalFileMediaResource(fileId: Int64.random(in: Int64.min ... Int64.max), size: Int64(thumbnailData.count))
+                    postbox.mediaBox.storeResourceData(resource.id, data: thumbnailData, synchronous: true)
+                    representations.append(TelegramMediaImageRepresentation(dimensions: PixelDimensions(width: image.thumbnailWidth, height: image.thumbnailHeight), resource: resource, progressiveSizes: [], immediateThumbnailData: nil))
+                }
+                let resource = LocalFileMediaResource(fileId: Int64.random(in: Int64.min ... Int64.max), size: Int64(image.data.count))
+                postbox.mediaBox.storeResourceData(resource.id, data: image.data, synchronous: true)
+                representations.append(TelegramMediaImageRepresentation(dimensions: PixelDimensions(width: image.width, height: image.height), resource: resource, progressiveSizes: [], immediateThumbnailData: nil))
+                media.append(TelegramMediaImage(imageId: MediaId(namespace: Namespaces.Media.LocalImage, id: Int64.random(in: Int64.min ... Int64.max)), representations: representations, immediateThumbnailData: nil, reference: nil, partialReference: nil, flags: []))
+            }
+            prepared.append((post, media))
+        }
+
+        return postbox.transaction { transaction -> Void in
+            for (post, media) in prepared {
+                let peerId = WsLocalAccount.channelPeerId(post.channelId)
+                let existing = transaction.getPeer(peerId) as? TelegramChannel
+
+                var needsUpdate = true
+                if let existing = existing, existing.title == post.channelTitle, case let .broadcast(info) = existing.info, info.flags.contains(.messagesShouldHaveSignatures) == post.signatures {
+                    needsUpdate = false
+                }
+                if needsUpdate {
+                    let channel = TelegramChannel(id: peerId, accessHash: nil, title: post.channelTitle, username: nil, photo: [], creationDate: existing?.creationDate ?? post.timestamp, version: 0, participationStatus: .member, info: .broadcast(TelegramChannelBroadcastInfo(flags: post.signatures ? [.messagesShouldHaveSignatures] : [])), flags: [], restrictionInfo: nil, adminRights: nil, bannedRights: nil, defaultBannedRights: nil, usernames: [], storiesHidden: nil, nameColor: nil, backgroundEmojiId: nil, profileColor: nil, profileBackgroundEmojiId: nil, emojiStatus: nil, approximateBoostLevel: nil, subscriptionUntilDate: nil, verificationIconFileId: nil, sendPaidMessageStars: nil, linkedMonoforumId: nil)
+                    updatePeersCustom(transaction: transaction, peers: [channel], update: { _, updated in
+                        return updated
+                    })
+                }
+                if existing == nil {
+                    // A new cloud peer starts with a history hole that would be fetched from the server.
+                    transaction.removeHole(peerId: peerId, threadId: nil, namespace: Namespaces.Message.Cloud, space: .everywhere, range: 1 ... (Int32.max - 1))
+                }
+                if transaction.getPeerReadStates(peerId)?.isEmpty ?? true {
+                    transaction.resetIncomingReadStates([peerId: [Namespaces.Message.Cloud: .idBased(maxIncomingReadId: 0, maxOutgoingReadId: 0, maxKnownId: 0, count: 0, markedUnread: false)]])
+                }
+
+                let firstId = (transaction.getTopPeerMessageId(peerId: peerId, namespace: Namespaces.Message.Cloud)?.id ?? 0) + 1
+
+                var attributes: [MessageAttribute] = []
+                if post.signatures, let postAuthor = post.postAuthor, !postAuthor.isEmpty {
+                    attributes.append(AuthorSignatureMessageAttribute(signature: postAuthor))
+                }
+
+                var messages: [StoreMessage] = []
+                if media.isEmpty {
+                    messages.append(WsLocalAccount.storeMessage(peerId: peerId, id: firstId, timestamp: post.timestamp, groupingKey: nil, text: post.text, entities: post.entities, attributes: attributes, media: []))
+                } else {
+                    let groupingKey: Int64? = media.count > 1 ? Int64.random(in: 1 ... Int64.max) : nil
+                    for i in 0 ..< media.count {
+                        let isFirst = i == 0
+                        messages.append(WsLocalAccount.storeMessage(peerId: peerId, id: firstId + Int32(i), timestamp: post.timestamp, groupingKey: groupingKey, text: isFirst ? post.text : "", entities: isFirst ? post.entities : [], attributes: attributes, media: [media[i]]))
+                    }
+                }
+                let _ = transaction.addMessages(messages, location: .UpperHistoryBlock)
+
+                switch transaction.getPeerChatListInclusion(peerId) {
+                case .ifHasMessagesOrOneOf:
+                    break
+                default:
+                    transaction.updatePeerChatListInclusion(peerId, inclusion: .ifHasMessagesOrOneOf(groupId: .root, pinningIndex: nil, minTimestamp: nil))
+                }
+            }
+        }
+    }
+
+    private static func storeMessage(peerId: PeerId, id: Int32, timestamp: Int32, groupingKey: Int64?, text: String, entities: [MessageTextEntity], attributes: [MessageAttribute], media: [Media]) -> StoreMessage {
+        var attributes = attributes
+        if !entities.isEmpty {
+            attributes.append(TextEntitiesMessageAttribute(entities: entities))
+        }
+        let (tags, globalTags) = tagsForStoreMessage(incoming: true, attributes: attributes, media: media, textEntities: entities, isPinned: false)
+        return StoreMessage(id: MessageId(peerId: peerId, namespace: Namespaces.Message.Cloud, id: id), customStableId: nil, globallyUniqueId: nil, groupingKey: groupingKey, threadId: nil, timestamp: timestamp, flags: [.Incoming], tags: tags, globalTags: globalTags, localTags: [], forwardInfo: nil, authorId: peerId, text: text, attributes: attributes, media: media)
+    }
+}
