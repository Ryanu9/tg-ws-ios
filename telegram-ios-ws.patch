+++ b/submodules/WsBridge/Sources/WsSubscription.swift
@@ -0,0 +1,135 @@
+import Foundation
+
+/// One WebSocket endpoint. Each one (or each blogger inside it) becomes a local broadcast channel.
+public struct WsSubscription: Codable, Equatable {
+    public static let authHeader = "header"
+    public static let authQuery = "query"
+    public static let authBoth = "both"
+    public static let authNone = "none"
+
+    public static let defaultName = "WS 订阅"
+
+    public var id: String
+    public var name: String
+    public var url: String
+    public var token: String
+    public var authMode: String
+    public var extraHeaders: String
+    public var enabled: Bool
+    /// One channel per actions.bloggerName (fallback 【name】 prefix / senderName). Otherwise one channel per subscription.
+    public var splitBySender: Bool
+
+    public init(id: String = WsSubscription.makeId(), name: String = WsSubscription.defaultName, url: String = "", token: String = "", authMode: String = WsSubscription.authHeader, extraHeaders: String = "", enabled: Bool = true, splitBySender: Bool = true) {
+        self.id = id
+        self.name = name
+        self.url = url
+        self.token = token
+        self.authMode = authMode
+        self.extraHeaders = extraHeaders
+        self.enabled = enabled
+        self.splitBySender = splitBySender
+    }
+
+    public static func makeId() -> String {
+        return String(UUID().uuidString.lowercased().replacingOccurrences(of: "-", with: "").prefix(8))
+    }
+
+    private enum CodingKeys: String, CodingKey {
+        case id, name, url, token, authMode, extraHeaders, enabled, splitBySender
+    }
+
+    public init(from decoder: Decoder) throws {
+        let c = try decoder.container(keyedBy: CodingKeys.self)
+        self.id = (try? c.decode(String.self, forKey: .id)) ?? WsSubscription.makeId()
+        self.name = (try? c.decode(String.self, forKey: .name)) ?? WsSubscription.defaultName
+        self.url = (try? c.decode(String.self, forKey: .url)) ?? ""
+        self.token = (try? c.decode(String.self, forKey: .token)) ?? ""
+        self.authMode = (try? c.decode(String.self, forKey: .authMode)) ?? WsSubscription.authHeader
+        self.extraHeaders = (try? c.decode(String.self, forKey: .extraHeaders)) ?? ""
+        self.enabled = (try? c.decode(Bool.self, forKey: .enabled)) ?? true
+        self.splitBySender = (try? c.decode(Bool.self, forKey: .splitBySender)) ?? true
+    }
+
+    public func encode(to encoder: Encoder) throws {
+        var c = encoder.container(keyedBy: CodingKeys.self)
+        try c.encode(self.id, forKey: .id)
+        try c.encode(self.name, forKey: .name)
+        try c.encode(self.url, forKey: .url)
+        try c.encode(self.token, forKey: .token)
+        try c.encode(self.authMode, forKey: .authMode)
+        try c.encode(self.extraHeaders, forKey: .extraHeaders)
+        try c.encode(self.enabled, forKey: .enabled)
+        try c.encode(self.splitBySender, forKey: .splitBySender)
+    }
+
+    public var trimmedUrl: String {
+        return self.url.trimmingCharacters(in: .whitespacesAndNewlines)
+    }
+
+    /// Display name: the configured name, or the host of the URL.
+    public var displayName: String {
+        let name = self.name.trimmingCharacters(in: .whitespacesAndNewlines)
+        if !name.isEmpty {
+            return name
+        }
+        if let host = URL(string: self.trimmedUrl)?.host, !host.isEmpty {
+            return host
+        }
+        return WsSubscription.defaultName
+    }
+
+    /// Everything that requires a reconnect when changed.
+    public var connectionSignature: String {
+        return [self.trimmedUrl, self.token, self.authMode, self.extraHeaders, self.enabled ? "1" : "0"].joined(separator: "\u{1}")
+    }
+
+    /// Builds the WebSocket handshake request. `since` resumes a tgpush relay (`?since=<seq>`).
+    public func makeRequest(since: Int64) -> URLRequest? {
+        var urlString = self.trimmedUrl
+        if urlString.isEmpty {
+            return nil
+        }
+        var token = self.token.trimmingCharacters(in: .whitespacesAndNewlines)
+        if token.lowercased().hasPrefix("bearer ") {
+            token = String(token.dropFirst(7)).trimmingCharacters(in: .whitespacesAndNewlines)
+        }
+        let useQuery = self.authMode == WsSubscription.authQuery || self.authMode == WsSubscription.authBoth
+        let useHeader = self.authMode == WsSubscription.authHeader || self.authMode == WsSubscription.authBoth
+        if !token.isEmpty && useQuery {
+            urlString += (urlString.contains("?") ? "&" : "?") + "access_token=" + WsSubscription.formEncode(token)
+        }
+        if since > 0 {
+            urlString += (urlString.contains("?") ? "&" : "?") + "since=\(since)"
+        }
+        guard let url = URL(string: urlString), let scheme = url.scheme?.lowercased(), ["ws", "wss", "http", "https"].contains(scheme) else {
+            return nil
+        }
+        var request = URLRequest(url: url)
+        request.timeoutInterval = 15.0
+        if !token.isEmpty && useHeader {
+            request.setValue("Bearer " + token, forHTTPHeaderField: "Authorization")
+        }
+        for line in self.extraHeaders.components(separatedBy: "\n") {
+            let t = line.trimmingCharacters(in: .whitespacesAndNewlines)
+            if t.isEmpty || t.hasPrefix("#") {
+                continue
+            }
+            guard let colon = t.firstIndex(of: ":"), colon != t.startIndex else {
+                continue
+            }
+            let key = t[t.startIndex ..< colon].trimmingCharacters(in: .whitespaces)
+            let value = t[t.index(after: colon)...].trimmingCharacters(in: .whitespaces)
+            if !key.isEmpty {
+                request.addValue(value, forHTTPHeaderField: key)
+            }
+        }
+        return request
+    }
+
+    /// Same as Java's URLEncoder.encode(_, "UTF-8").
+    static func formEncode(_ value: String) -> String {
+        let allowed = CharacterSet(charactersIn: "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_.*")
+        let encoded = value.addingPercentEncoding(withAllowedCharacters: allowed) ?? value
+        return encoded.replacingOccurrences(of: "%20", with: "+")
+    }
+}
diff --git a/submodules/WsBridge/Sources/WsSubscriptionEditController.swift b/submodules/WsBridge/Sources/WsSubscriptionEditController.swift
new file mode 100644
index 00000000..b88721f2
--- /dev/null
+++ b/submodules/WsBridge/Sources/WsSubscriptionEditController.swift
@@ -0,0 +1,361 @@
+import Foundation
+import UIKit
+
+/// Add / edit one WebSocket subscription.
+final class WsSubscriptionEditController: UITableViewController, UITextFieldDelegate, UITextViewDelegate {
+    private enum Section: Int, CaseIterable {
+        case connection
+        case authMode
+        case options
+        case advanced
+        case actions
+    }
+
+    private static let authModes: [(String, String)] = [
+        (WsSubscription.authHeader, "请求头 Authorization"),
+        (WsSubscription.authQuery, "URL 参数 access_token"),
+        (WsSubscription.authBoth, "两者都发送"),
+        (WsSubscription.authNone, "不发送")
+    ]
+
+    private let bridge = WsBridgeManager.shared
+    private let isNew: Bool
+    private let original: WsSubscription
+    private var draft: WsSubscription
+    private var testResult: (String, UIColor)?
+
+    init(subscription: WsSubscription?) {
+        self.isNew = subscription == nil
+        let value = subscription ?? WsSubscription()
+        self.original = value
+        self.draft = value
+        super.init(style: .insetGrouped)
+    }
+
+    required init?(coder: NSCoder) {
+        fatalError("init(coder:) has not been implemented")
+    }
+
+    override func viewDidLoad() {
+        super.viewDidLoad()
+        self.title = self.isNew ? "添加订阅" : "编辑订阅"
+        self.navigationItem.leftBarButtonItem = UIBarButtonItem(title: "取消", style: .plain, target: self, action: #selector(self.cancelPressed))
+        self.navigationItem.rightBarButtonItem = UIBarButtonItem(title: "保存", style: .done, target: self, action: #selector(self.savePressed))
+        self.tableView.keyboardDismissMode = .interactive
+    }
+
+    // MARK: - Actions
+
+    @objc private func cancelPressed() {
+        self.view.endEditing(true)
+        if self.draft == self.original {
+            self.close()
+            return
+        }
+        let alert = UIAlertController(title: "放弃修改？", message: nil, preferredStyle: .alert)
+        alert.addAction(UIAlertAction(title: "继续编辑", style: .cancel, handler: nil))
+        alert.addAction(UIAlertAction(title: "放弃", style: .destructive, handler: { [weak self] _ in
+            self?.close()
+        }))
+        self.present(alert, animated: true, completion: nil)
+    }
+
+    @objc private func savePressed() {
+        self.view.endEditing(true)
+        guard let error = self.validationError() else {
+            var value = self.draft
+            value.url = value.trimmedUrl
+            value.name = value.name.trimmingCharacters(in: .whitespacesAndNewlines)
+            value.token = value.token.trimmingCharacters(in: .whitespacesAndNewlines)
+            self.bridge.store.upsert(value)
+            self.bridge.start()
+            self.close()
+            return
+        }
+        self.showAlert(error)
+    }
+
+    private func validationError() -> String? {
+        let url = self.draft.trimmedUrl.lowercased()
+        if url.isEmpty {
+            return "请填写地址"
+        }
+        if !url.hasPrefix("ws://") && !url.hasPrefix("wss://") {
+            return "需以 ws:// 或 wss:// 开头"
+        }
+        if self.draft.makeRequest(since: 0) == nil {
+            return "地址格式不正确"
+        }
+        return nil
+    }
+
+    private func close() {
+        if let navigationController = self.navigationController, navigationController.viewControllers.first !== self {
+            navigationController.popViewController(animated: true)
+        } else {
+            self.dismiss(animated: true, completion: nil)
+        }
+    }
+
+    private func showAlert(_ message: String) {
+        let alert = UIAlertController(title: nil, message: message, preferredStyle: .alert)
+        alert.addAction(UIAlertAction(title: "好", style: .default, handler: nil))
+        self.present(alert, animated: true, completion: nil)
+    }
+
+    private func testConnection() {
+        self.view.endEditing(true)
+        if let error = self.validationError() {
+            self.showAlert(error)
+            return
+        }
+        self.testResult = ("连接中…", .secondaryLabel)
+        self.reloadActions()
+        self.bridge.test(self.draft, completion: { [weak self] ok, message in
+            guard let self = self else {
+                return
+            }
+            self.testResult = ok ? ("成功 · " + message, .systemGreen) : ("失败：" + message, .systemRed)
+            self.reloadActions()
+        })
+    }
+
+    private func confirmDelete() {
+        let alert = UIAlertController(title: "删除订阅", message: "已收到的消息会保留在聊天列表中。", preferredStyle: .alert)
+        alert.addAction(UIAlertAction(title: "取消", style: .cancel, handler: nil))
+        alert.addAction(UIAlertAction(title: "删除", style: .destructive, handler: { [weak self] _ in
+            guard let self = self else {
+                return
+            }
+            self.bridge.store.remove(id: self.original.id)
+            self.bridge.start()
+            self.close()
+        }))
+        self.present(alert, animated: true, completion: nil)
+    }
+
+    private func reloadActions() {
+        self.tableView.reloadSections(IndexSet(integer: Section.actions.rawValue), with: .none)
+    }
+
+    // MARK: - Table
+
+    override func numberOfSections(in tableView: UITableView) -> Int {
+        return Section.allCases.count
+    }
+
+    override func tableView(_ tableView: UITableView, numberOfRowsInSection section: Int) -> Int {
+        switch Section(rawValue: section)! {
+        case .connection:
+            return 3
+        case .authMode:
+            return WsSubscriptionEditController.authModes.count
+        case .options:
+            return 2
+        case .advanced:
+            return 1
+        case .actions:
+            return self.isNew ? 1 : 2
+        }
+    }
+
+    override func tableView(_ tableView: UITableView, titleForHeaderInSection section: Int) -> String? {
+        switch Section(rawValue: section)! {
+        case .connection:
+            return "连接"
+        case .authMode:
+            return "Token 发送方式"
+        case .options:
+            return "频道"
+        case .advanced:
+            return "高级 · 额外请求头（每行 Key: Value）"
+        case .actions:
+            return nil
+        }
+    }
+
+    override func tableView(_ tableView: UITableView, titleForFooterInSection section: Int) -> String? {
+        switch Section(rawValue: section)! {
+        case .connection:
+            return "地址以 ws:// 或 wss:// 开头。tgpush 中转服务会自动带上 since 参数补发断线期间的消息。"
+        case .options:
+            return "开启拆分后每个博主单独一个对话；关闭时同一订阅的消息进入同一个频道，并以署名显示博主。"
+        default:
+            return nil
+        }
+    }
+
+    override func tableView(_ tableView: UITableView, heightForRowAt indexPath: IndexPath) -> CGFloat {
+        if indexPath.section == Section.advanced.rawValue {
+            return 120.0
+        }
+        return UITableView.automaticDimension
+    }
+
+    override func tableView(_ tableView: UITableView, cellForRowAt indexPath: IndexPath) -> UITableViewCell {
+        switch Section(rawValue: indexPath.section)! {
+        case .connection:
+            switch indexPath.row {
+            case 0:
+                return self.textFieldCell(tag: 0, label: "名称", placeholder: "名称（可选）", text: self.draft.name, keyboard: .default)
+            case 1:
+                return self.textFieldCell(tag: 1, label: "地址", placeholder: "ws:// 或 wss://", text: self.draft.url, keyboard: .URL)
+            default:
+                return self.textFieldCell(tag: 2, label: "Token", placeholder: "Token（可选）", text: self.draft.token, keyboard: .asciiCapable)
+            }
+        case .authMode:
+            let (mode, title) = WsSubscriptionEditController.authModes[indexPath.row]
+            let cell = UITableViewCell(style: .default, reuseIdentifier: nil)
+            cell.textLabel?.text = title
+            cell.accessoryType = self.draft.authMode == mode ? .checkmark : .none
+            return cell
+        case .options:
+            let cell = UITableViewCell(style: .default, reuseIdentifier: nil)
+            cell.selectionStyle = .none
+            let control = UISwitch()
+            if indexPath.row == 0 {
+                cell.textLabel?.text = "按博主拆分频道"
+                control.isOn = self.draft.splitBySender
+                control.addTarget(self, action: #selector(self.splitSwitchChanged(_:)), for: .valueChanged)
+            } else {
+                cell.textLabel?.text = "启用"
+                control.isOn = self.draft.enabled
+                control.addTarget(self, action: #selector(self.enabledSwitchChanged(_:)), for: .valueChanged)
+            }
+            cell.accessoryView = control
+            return cell
+        case .advanced:
+            let cell = UITableViewCell(style: .default, reuseIdentifier: nil)
+            cell.selectionStyle = .none
+            let textView = UITextView()
+            textView.translatesAutoresizingMaskIntoConstraints = false
+            textView.font = UIFont.monospacedSystemFont(ofSize: 14.0, weight: .regular)
+            textView.backgroundColor = .clear
+            textView.autocapitalizationType = .none
+            textView.autocorrectionType = .no
+            textView.smartQuotesType = .no
+            textView.smartDashesType = .no
+            textView.text = self.draft.extraHeaders
+            textView.delegate = self
+            cell.contentView.addSubview(textView)
+            NSLayoutConstraint.activate([
+                textView.leadingAnchor.constraint(equalTo: cell.contentView.layoutMarginsGuide.leadingAnchor, constant: -4.0),
+                textView.trailingAnchor.constraint(equalTo: cell.contentView.layoutMarginsGuide.trailingAnchor),
+                textView.topAnchor.constraint(equalTo: cell.contentView.topAnchor, constant: 4.0),
+                textView.bottomAnchor.constraint(equalTo: cell.contentView.bottomAnchor, constant: -4.0)
+            ])
+            return cell
+        case .actions:
+            if indexPath.row == 0 {
+                let cell = UITableViewCell(style: .value1, reuseIdentifier: nil)
+                cell.textLabel?.text = "测试连接"
+                cell.textLabel?.textColor = self.view.tintColor
+                if let (text, color) = self.testResult {
+                    cell.detailTextLabel?.text = text
+                    cell.detailTextLabel?.textColor = color
+                    cell.detailTextLabel?.numberOfLines = 2
+                }
+                return cell
+            } else {
+                let cell = UITableViewCell(style: .default, reuseIdentifier: nil)
+                cell.textLabel?.text = "删除订阅"
+                cell.textLabel?.textColor = .systemRed
+                return cell
+            }
+        }
+    }
+
+    override func tableView(_ tableView: UITableView, didSelectRowAt indexPath: IndexPath) {
+        tableView.deselectRow(at: indexPath, animated: true)
+        switch Section(rawValue: indexPath.section)! {
+        case .authMode:
+            self.view.endEditing(true)
+            self.draft.authMode = WsSubscriptionEditController.authModes[indexPath.row].0
+            tableView.reloadSections(IndexSet(integer: Section.authMode.rawValue), with: .none)
+        case .actions:
+            if indexPath.row == 0 {
+                self.testConnection()
+            } else {
+                self.confirmDelete()
+            }
+        default:
+            break
+        }
+    }
+
+    // MARK: - Cells
+
+    private func textFieldCell(tag: Int, label: String, placeholder: String, text: String, keyboard: UIKeyboardType) -> UITableViewCell {
+        let cell = UITableViewCell(style: .default, reuseIdentifier: nil)
+        cell.selectionStyle = .none
+
+        let titleLabel = UILabel()
+        titleLabel.translatesAutoresizingMaskIntoConstraints = false
+        titleLabel.text = label
+        titleLabel.font = UIFont.preferredFont(forTextStyle: .body)
+        titleLabel.setContentHuggingPriority(.required, for: .horizontal)
+        titleLabel.setContentCompressionResistancePriority(.required, for: .horizontal)
+
+        let field = UITextField()
+        field.translatesAutoresizingMaskIntoConstraints = false
+        field.tag = tag
+        field.placeholder = placeholder
+        field.text = text
+        field.font = UIFont.preferredFont(forTextStyle: .body)
+        field.keyboardType = keyboard
+        field.clearButtonMode = .whileEditing
+        field.returnKeyType = .done
+        field.delegate = self
+        if tag != 0 {
+            field.autocapitalizationType = .none
+            field.autocorrectionType = .no
+            field.spellCheckingType = .no
+            field.smartQuotesType = .no
+            field.smartDashesType = .no
+        }
+        field.addTarget(self, action: #selector(self.textFieldChanged(_:)), for: .editingChanged)
+
+        cell.contentView.addSubview(titleLabel)
+        cell.contentView.addSubview(field)
+        let margins = cell.contentView.layoutMarginsGuide
+        NSLayoutConstraint.activate([
+            titleLabel.leadingAnchor.constraint(equalTo: margins.leadingAnchor),
+            titleLabel.widthAnchor.constraint(equalToConstant: 64.0),
+            titleLabel.centerYAnchor.constraint(equalTo: cell.contentView.centerYAnchor),
+            field.leadingAnchor.constraint(equalTo: titleLabel.trailingAnchor, constant: 8.0),
+            field.trailingAnchor.constraint(equalTo: margins.trailingAnchor),
+            field.topAnchor.constraint(equalTo: cell.contentView.topAnchor, constant: 11.0),
+            field.bottomAnchor.constraint(equalTo: cell.contentView.bottomAnchor, constant: -11.0)
+        ])
+        return cell
+    }
+
+    @objc private func textFieldChanged(_ field: UITextField) {
+        let value = field.text ?? ""
+        switch field.tag {
+        case 0:
+            self.draft.name = value
+        case 1:
+            self.draft.url = value
+        default:
+            self.draft.token = value
+        }
+    }
+
+    func textFieldShouldReturn(_ textField: UITextField) -> Bool {
+        textField.resignFirstResponder()
+        return true
+    }
+
+    func textViewDidChange(_ textView: UITextView) {
+        self.draft.extraHeaders = textView.text ?? ""
+    }
+
+    @objc private func splitSwitchChanged(_ sender: UISwitch) {
+        self.draft.splitBySender = sender.isOn
+    }
+
+    @objc private func enabledSwitchChanged(_ sender: UISwitch) {
+        self.draft.enabled = sender.isOn
+    }
+}
