diff --git a/submodules/WsBridge/Sources/WsBridgeManager.swift b/submodules/WsBridge/Sources/WsBridgeManager.swift
new file mode 100644
index 00000000..fed707ae
--- /dev/null
+++ b/submodules/WsBridge/Sources/WsBridgeManager.swift
@@ -0,0 +1,415 @@
+import Foundation
+import UIKit
+import Network
+import SwiftSignalKit
+import TelegramCore
+import AccountContext
+import TextFormat
+
+/// Built-in WebSocket receiver. Every frame becomes a post in a local broadcast channel of the
+/// local-only account (see `WsLocalAccount`), so it shows up natively in the chat list.
+/// Port of the Android `WsBridge`. Main queue only.
+public final class WsBridgeManager {
+    public static let shared = WsBridgeManager()
+
+    /// Posted on the main queue whenever a connection state or the configuration changes.
+    public static let statusDidChangeNotification = Notification.Name("WsBridgeStatusDidChange")
+
+    public struct Status: Equatable {
+        public var state: WsConnectionState
+        public var detail: String
+        public var since: Date
+    }
+
+    public let store = WsStore.shared
+    public private(set) var status: [String: Status] = [:]
+
+    private weak var context: AccountContext?
+    private var connections: [String: WsConnection] = [:]
+    private var pendingPosts: [WsLocalAccount.Post] = []
+    private var flushScheduled = false
+    private var observers: [NSObjectProtocol] = []
+    private var pathMonitor: NWPathMonitor?
+    private var networkAvailable = true
+
+    private init() {
+    }
+
+    public var isAttached: Bool {
+        return self.context != nil
+    }
+
+    // MARK: - Lifecycle
+
+    /// Called by the app whenever the active account context changes.
+    public func setContext(_ context: AccountContext?) {
+        if let context = context, WsLocalAccount.isLocal(context.account.peerId) {
+            if self.context !== context {
+                self.context = context
+                self.registerObservers()
+                WsNotifier.shared.requestAuthorizationIfNeeded()
+                self.start()
+            }
+        } else if self.context != nil || !self.connections.isEmpty {
+            self.context = nil
+            self.stopAll(markStopped: false)
+            WsKeepAlive.shared.setEnabled(false)
+            WsLocalAccount.networkState.set(.online(proxy: nil))
+        }
+    }
+
+    /// (Re)applies the stored configuration: opens, keeps or closes links as needed.
+    public func start() {
+        guard self.context != nil else {
+            return
+        }
+        if !self.store.serviceEnabled {
+            self.stopAll(markStopped: true)
+            WsKeepAlive.shared.setEnabled(false)
+            return
+        }
+        let subscriptions = self.store.subscriptions
+        for (id, connection) in self.connections {
+            let current = subscriptions.first(where: { $0.id == id })
+            if current == nil || current?.enabled != true || current?.trimmedUrl.isEmpty != false || current?.connectionSignature != connection.connectionSignature {
+                connection.close()
+                self.connections.removeValue(forKey: id)
+            }
+        }
+        var updatedStatus: [String: Status] = [:]
+        var toConnect: [WsSubscription] = []
+        for subscription in subscriptions {
+            if !subscription.enabled {
+                updatedStatus[subscription.id] = Status(state: .disabled, detail: "已停用", since: Date())
+                continue
+            }
+            if subscription.trimmedUrl.isEmpty {
+                updatedStatus[subscription.id] = Status(state: .disabled, detail: "未配置地址", since: Date())
+                continue
+            }
+            if let connection = self.connections[subscription.id] {
+                if let current = self.status[subscription.id], current.state == connection.state {
+                    updatedStatus[subscription.id] = current
+                } else {
+                    let detail: String
+                    switch connection.state {
+                    case .connected:
+                        detail = "已连接"
+                    case .connecting:
+                        detail = "连接中…"
+                    case .waiting, .disabled:
+                        detail = "等待重连"
+                    }
+                    updatedStatus[subscription.id] = Status(state: connection.state, detail: detail, since: Date())
+                }
+            } else {
+                toConnect.append(subscription)
+            }
+        }
+        self.status = updatedStatus
+        // connect() reports "连接中…" synchronously through onStatus
+        for subscription in toConnect {
+            let connection = self.makeConnection(subscription)
+            self.connections[subscription.id] = connection
+            connection.connect()
+        }
+        WsKeepAlive.shared.setEnabled(self.store.keepAliveEnabled && !self.connections.isEmpty)
+        self.statusChanged()
+    }
+
+    private func stopAll(markStopped: Bool) {
+        for (_, connection) in self.connections {
+            connection.close()
+        }
+        self.connections.removeAll()
+        self.status.removeAll()
+        if markStopped {
+            for subscription in self.store.subscriptions {
+                self.status[subscription.id] = Status(state: .disabled, detail: "已停止", since: Date())
+            }
+        }
+        self.statusChanged()
+    }
+
+    /// Manual "reconnect now": forces every non-connected link (resets backoff, ignores Retry-After).
+    public func reconnectNow() {
+        if self.connections.isEmpty {
+            self.start()
+            return
+        }
+        for (_, connection) in self.connections {
+            connection.reconnectNow()
+        }
+    }
+
+    private func makeConnection(_ subscription: WsSubscription) -> WsConnection {
+        let subscriptionId = subscription.id
+        let store = self.store
+        let connection = WsConnection(subscriptionId: subscriptionId, connectionSignature: subscription.connectionSignature, makeRequest: {
+            guard let current = store.subscription(id: subscriptionId) else {
+                return nil
+            }
+            return current.makeRequest(since: store.lastSeq(current))
+        })
+        connection.onStatus = { [weak self] state, detail in
+            self?.setStatus(subscriptionId, state: state, detail: detail)
+        }
+        connection.onFrame = { [weak self, weak connection] text in
+            guard let self = self, let connection = connection else {
+                return
+            }
+            self.handleFrame(subscriptionId: subscriptionId, raw: text, connection: connection)
+        }
+        return connection
+    }
+
+    private func registerObservers() {
+        if !self.observers.isEmpty {
+            return
+        }
+        let center = NotificationCenter.default
+        self.observers.append(center.addObserver(forName: UIApplication.didBecomeActiveNotification, object: nil, queue: .main, using: { [weak self] _ in
+            // iOS suspends sockets in the background: reconnect right away when the user comes back
+            self?.reconnectNow()
+        }))
+        let monitor = NWPathMonitor()
+        monitor.pathUpdateHandler = { [weak self] path in
+            let available = path.status == .satisfied
+            DispatchQueue.main.async {
+                guard let self = self else {
+                    return
+                }
+                let becameAvailable = available && !self.networkAvailable
+                self.networkAvailable = available
+                if becameAvailable {
+                    for (_, connection) in self.connections {
+                        connection.networkAvailable()
+                    }
+                }
+                self.updateNetworkState()
+            }
+        }
+        monitor.start(queue: DispatchQueue(label: "WsBridge.PathMonitor"))
+        self.pathMonitor = monitor
+    }
+
+    // MARK: - Status
+
+    private func setStatus(_ subscriptionId: String, state: WsConnectionState, detail: String) {
+        self.status[subscriptionId] = Status(state: state, detail: detail, since: Date())
+        self.statusChanged()
+    }
+
+    private func statusChanged() {
+        self.updateNetworkState()
+        NotificationCenter.default.post(name: WsBridgeManager.statusDidChangeNotification, object: self)
+    }
+
+    public var connectedCount: Int {
+        return self.status.values.filter { $0.state == .connected }.count
+    }
+
+    public var activeCount: Int {
+        return self.status.values.filter { $0.state != .disabled }.count
+    }
+
+    /// Mapped onto Telegram's own connection states so the chat list title shows "Connecting..." etc.
+    private func updateNetworkState() {
+        let state: AccountNetworkState
+        if self.activeCount == 0 || self.connectedCount > 0 {
+            state = .online(proxy: nil)
+        } else if !self.networkAvailable {
+            state = .waitingForNetwork
+        } else {
+            state = .connecting(proxy: nil)
+        }
+        WsLocalAccount.networkState.set(state)
+    }
+
+    // MARK: - Frames
+
+    private func handleFrame(subscriptionId: String, raw: String, connection: WsConnection) {
+        guard let context = self.context, let subscription = self.store.subscription(id: subscriptionId) else {
+            return
+        }
+        let result = WsParser.parse(raw)
+        switch result.kind {
+        case .ignore:
+            return
+        case .ping:
+            if raw.uppercased().contains("PING") {
+                connection.send(WsParser.trim(raw).hasPrefix("{") ? "{\"type\":\"PONG\"}" : "pong")
+            }
+            return
+        case .connected:
+            self.setStatus(subscriptionId, state: .connected, detail: "已连接（CONNECTED）")
+            return
+        case .message:
+            break
+        }
+        if result.seq > 0 {
+            self.store.updateSeq(subscription, result.seq)
+        }
+        if self.store.checkAndMarkSeen(subscriptionId: subscriptionId, uid: result.uid) {
+            return
+        }
+        let target = WsTarget.make(subscription: subscription, result: result)
+        if target.text.isEmpty && result.images.isEmpty {
+            return
+        }
+        let peerId = WsLocalAccount.channelPeerId(target.channelId)
+
+        let nowMs = Int64(Date().timeIntervalSince1970 * 1000.0)
+
+        // Notify right now -- before image downloads / DB / UI. Messages replayed by the relay after
+        // the app comes back to the foreground are already visible in the chat list: no banner for them.
+        let isReplayedWhileActive = UIApplication.shared.applicationState == .active && result.timeMs > 0 && nowMs - result.timeMs > 120 * 1000
+        if !isReplayedWhileActive {
+            WsNotifier.shared.notify(context: context, peerId: peerId, title: target.title, sender: target.postAuthor, text: target.text, imageCount: result.images.count)
+        }
+
+        let timeMs = (result.timeMs > 0 && abs(result.timeMs - nowMs) < 7 * 86400 * 1000) ? result.timeMs : nowMs
+        let timestamp = Int32(timeMs / 1000)
+
+        if result.images.isEmpty {
+            self.enqueue(target: target, timestamp: timestamp, text: target.text, images: [])
+            return
+        }
+        let urls = result.images
+        WsImageLoader.load(urls: urls, completion: { [weak self] images in
+            guard let self = self else {
+                return
+            }
+            var loaded: [WsLocalAccount.Image] = []
+            var failed: [String] = []
+            for (index, image) in images.enumerated() {
+                if let image = image {
+                    loaded.append(image)
+                } else if index < urls.count {
+                    failed.append(urls[index])
+                }
+            }
+            var caption = target.text
+            if !failed.isEmpty {
+                caption = WsParser.trim(caption + "\n" + failed.joined(separator: "\n"))
+            }
+            if loaded.isEmpty && caption.isEmpty {
+                caption = "[图片加载失败]"
+            }
+            self.enqueue(target: target, timestamp: timestamp, text: caption, images: loaded)
+        })
+    }
+
+    private func enqueue(target: WsTarget, timestamp: Int32, text: String, images: [WsLocalAccount.Image]) {
+        let entities = generateTextEntities(text, enabledTypes: [.allUrl])
+        self.pendingPosts.append(WsLocalAccount.Post(channelId: target.channelId, channelTitle: target.title, signatures: !target.split, timestamp: timestamp, text: text, entities: entities, postAuthor: target.postAuthor, images: images))
+        // Frames arrive one run loop turn apart: wait a moment so a replay of hundreds becomes a few
+        // database transactions instead of hundreds (adds ~50 ms to a single live message).
+        if !self.flushScheduled {
+            self.flushScheduled = true
+            DispatchQueue.main.asyncAfter(deadline: .now() + 0.05) { [weak self] in
+                self?.flush()
+            }
+        }
+    }
+
+    private func flush() {
+        self.flushScheduled = false
+        guard let context = self.context, !self.pendingPosts.isEmpty else {
+            self.pendingPosts.removeAll()
+            return
+        }
+        let posts = self.pendingPosts
+        self.pendingPosts.removeAll()
+        self.store.persistSeen()
+        let _ = WsLocalAccount.ingest(account: context.account, posts: posts).start()
+    }
+
+    // MARK: - Testing helpers
+
+    /// Opens a short-lived link to check URL / token. `completion` runs on the main queue.
+    public func test(_ subscription: WsSubscription, completion: @escaping (Bool, String) -> Void) {
+        WsConnectionTester.run(subscription: subscription, since: 0, completion: completion)
+    }
+
+    /// Posts a sample notification for the subscription's channel.
+    public func sendTestNotification() {
+        guard let context = self.context else {
+            return
+        }
+        WsNotifier.shared.requestAuthorizationIfNeeded()
+        let subscription = self.store.subscriptions.first
+        let channelId = WsTarget.channelId(subscriptionId: subscription?.id ?? "test")
+        WsNotifier.shared.notify(context: context, peerId: WsLocalAccount.channelPeerId(channelId), title: subscription?.displayName ?? "WebSocket", sender: nil, text: "如果你看到了这条通知，WebSocket 新消息提醒已正常工作 ✓", imageCount: 0, ignoreMute: true)
+    }
+}
+
+/// One-shot handshake check used by the "测试连接" button.
+private final class WsConnectionTester: NSObject, URLSessionWebSocketDelegate {
+    private static var running: [WsConnectionTester] = []
+
+    private let completion: (Bool, String) -> Void
+    private let start = Date()
+    private var session: URLSession?
+    private var task: URLSessionWebSocketTask?
+    private var finished = false
+
+    private init(completion: @escaping (Bool, String) -> Void) {
+        self.completion = completion
+        super.init()
+    }
+
+    static func run(subscription: WsSubscription, since: Int64, completion: @escaping (Bool, String) -> Void) {
+        guard let request = subscription.makeRequest(since: since) else {
+            completion(false, "地址无效")
+            return
+        }
+        let tester = WsConnectionTester(completion: completion)
+        WsConnectionTester.running.append(tester)
+        let configuration = URLSessionConfiguration.ephemeral
+        configuration.connectionProxyDictionary = [:]
+        configuration.timeoutIntervalForRequest = 10.0
+        let session = URLSession(configuration: configuration, delegate: tester, delegateQueue: OperationQueue.main)
+        tester.session = session
+        let task = session.webSocketTask(with: request)
+        tester.task = task
+        task.resume()
+        DispatchQueue.main.asyncAfter(deadline: .now() + 10.0) { [weak tester] in
+            tester?.finish(false, "超时（10s）")
+        }
+    }
+
+    private func finish(_ ok: Bool, _ message: String) {
+        if self.finished {
+            return
+        }
+        self.finished = true
+        self.completion(ok, message)
+        let task = self.task
+        let session = self.session
+        DispatchQueue.main.asyncAfter(deadline: .now() + (ok ? 1.5 : 0.0)) {
+            task?.cancel(with: .normalClosure, reason: nil)
+            session?.invalidateAndCancel()
+        }
+        self.task = nil
+        self.session = nil
+        WsConnectionTester.running.removeAll(where: { $0 === self })
+    }
+
+    func urlSession(_ session: URLSession, webSocketTask: URLSessionWebSocketTask, didOpenWithProtocol protocol: String?) {
+        self.finish(true, "\(Int(Date().timeIntervalSince(self.start) * 1000.0))ms")
+    }
+
+    func urlSession(_ session: URLSession, webSocketTask: URLSessionWebSocketTask, didCloseWith closeCode: URLSessionWebSocketTask.CloseCode, reason: Data?) {
+        self.finish(false, "连接关闭 code=\(closeCode.rawValue)")
+    }
+
+    func urlSession(_ session: URLSession, task: URLSessionTask, didCompleteWithError error: Error?) {
+        let statusCode = (task.response as? HTTPURLResponse)?.statusCode ?? 0
+        var message = error.map { WsConnection.describe($0) } ?? "连接已断开"
+        if statusCode > 0 && statusCode != 101 {
+            message = "HTTP \(statusCode) " + message
+        }
+        self.finish(false, message)
+    }
+}
