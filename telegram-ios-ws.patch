new file mode 100644
index 00000000..e6bb350b
--- /dev/null
+++ b/submodules/WsBridge/Sources/WsConnection.swift
@@ -0,0 +1,343 @@
+import Foundation
+#if canImport(FoundationNetworking)
+import FoundationNetworking
+#endif
+
+public enum WsConnectionState: Equatable {
+    case disabled
+    case connecting
+    case connected
+    case waiting
+}
+
+/// One WebSocket link with reconnect/backoff. Port of the Android `WsBridge.Conn`.
+/// All callbacks and all methods run on the main queue.
+final class WsConnection: NSObject, URLSessionWebSocketDelegate {
+    let subscriptionId: String
+    let connectionSignature: String
+    private let makeRequest: () -> URLRequest?
+
+    var onStatus: ((WsConnectionState, String) -> Void)?
+    var onFrame: ((String) -> Void)?
+
+    private(set) var state: WsConnectionState = .connecting
+    private var session: URLSession?
+    private var task: URLSessionWebSocketTask?
+    private var attempt = 0
+    /// Earliest time we may reconnect, from HTTP 429 Retry-After.
+    private(set) var notBefore: Date?
+    private var openedAt: Date?
+    private var closed = false
+    private var retryTimer: Timer?
+    private var pingTimer: Timer?
+
+    init(subscriptionId: String, connectionSignature: String, makeRequest: @escaping () -> URLRequest?) {
+        self.subscriptionId = subscriptionId
+        self.connectionSignature = connectionSignature
+        self.makeRequest = makeRequest
+        super.init()
+        let configuration = URLSessionConfiguration.default
+        // Always direct: an HTTP proxy that does not understand the Upgrade handshake kills ws:// links.
+        configuration.connectionProxyDictionary = [:]
+        configuration.timeoutIntervalForRequest = 15.0
+        configuration.timeoutIntervalForResource = 7 * 24 * 60 * 60
+        configuration.waitsForConnectivity = false
+        self.session = URLSession(configuration: configuration, delegate: self, delegateQueue: OperationQueue.main)
+    }
+
+    func connect() {
+        if self.closed {
+            return
+        }
+        self.retryTimer?.invalidate()
+        self.retryTimer = nil
+        self.stopPing()
+        if let task = self.task {
+            self.task = nil
+            task.cancel(with: .goingAway, reason: nil)
+        }
+        self.setState(.connecting, "连接中…")
+        guard let request = self.makeRequest(), let session = self.session else {
+            self.state = .waiting
+            self.onStatus?(.waiting, "地址无效")
+            return
+        }
+        let task = session.webSocketTask(with: request)
+        task.maximumMessageSize = 16 * 1024 * 1024
+        self.task = task
+        task.resume()
+        self.receive(task)
+    }
+
+    /// Manual "reconnect now": resets the backoff and ignores Retry-After.
+    func reconnectNow() {
+        if self.state == .connected {
+            return
+        }
+        self.attempt = 0
+        self.notBefore = nil
+        self.connect()
+    }
+
+    /// Network came back: retry a waiting link without killing an in-flight handshake.
+    func networkAvailable() {
+        if self.state != .waiting {
+            return
+        }
+        self.attempt = 0
+        if let notBefore = self.notBefore, notBefore > Date() {
+            self.scheduleRetry(after: notBefore.timeIntervalSinceNow)
+        } else {
+            self.connect()
+        }
+    }
+
+    func send(_ text: String) {
+        self.task?.send(.string(text), completionHandler: { _ in })
+    }
+
+    func close() {
+        self.closed = true
+        self.retryTimer?.invalidate()
+        self.retryTimer = nil
+        self.stopPing()
+        if let task = self.task {
+            self.task = nil
+            task.cancel(with: .normalClosure, reason: nil)
+        }
+        self.session?.invalidateAndCancel()
+        self.session = nil
+    }
+
+    // MARK: - Receiving
+
+    private func receive(_ task: URLSessionWebSocketTask) {
+        task.receive { [weak self] result in
+            DispatchQueue.main.async {
+                guard let self = self, self.task === task else {
+                    return
+                }
+                switch result {
+                case let .success(message):
+                    switch message {
+                    case let .string(text):
+                        self.onFrame?(text)
+                    case let .data(data):
+                        self.onFrame?(String(decoding: data, as: UTF8.self))
+                    @unknown default:
+                        break
+                    }
+                    self.receive(task)
+                case let .failure(error):
+                    self.handleFailure(task: task, error: error)
+                }
+            }
+        }
+    }
+
+    // MARK: - URLSessionWebSocketDelegate
+
+    func urlSession(_ session: URLSession, webSocketTask: URLSessionWebSocketTask, didOpenWithProtocol protocol: String?) {
+        guard webSocketTask === self.task else {
+            return
+        }
+        // backoff is reset in fail() only if the link stayed up a while (no 0.5s flap loop -> 429)
+        self.openedAt = Date()
+        self.notBefore = nil
+        self.setState(.connected, "已连接")
+        self.startPing(webSocketTask)
+    }
+
+    func urlSession(_ session: URLSession, webSocketTask: URLSessionWebSocketTask, didCloseWith closeCode: URLSessionWebSocketTask.CloseCode, reason: Data?) {
+        guard webSocketTask === self.task else {
+            return
+        }
+        self.task = nil
+        self.handleClose(code: closeCode.rawValue, reason: reason.flatMap { String(data: $0, encoding: .utf8) } ?? "")
+    }
+
+    func urlSession(_ session: URLSession, task: URLSessionTask, didCompleteWithError error: Error?) {
+        guard let webSocketTask = task as? URLSessionWebSocketTask, webSocketTask === self.task else {
+            return
+        }
+        self.handleFailure(task: webSocketTask, error: error)
+    }
+
+    // MARK: - Failures
+
+    private func handleClose(code: Int, reason: String) {
+        if self.closed {
+            return
+        }
+        self.stopPing()
+        if code == 1013 || code == 4029 || code == 4290 {
+            self.fail429("连接关闭 code=\(code)（服务端限流）", retryAfter: nil)
+            return
+        }
+        var message = "连接关闭 code=\(code)"
+        if !reason.isEmpty {
+            message += " " + reason
+        }
+        if code == 1008 || code == 4001 || code == 4003 {
+            message += "（可能鉴权失败）"
+        }
+        self.fail(message)
+    }
+
+    private func handleFailure(task: URLSessionWebSocketTask, error: Error?) {
+        if self.closed || self.task !== task {
+            return
+        }
+        self.task = nil
+        self.stopPing()
+        if task.closeCode != .invalid {
+            self.handleClose(code: task.closeCode.rawValue, reason: task.closeReason.flatMap { String(data: $0, encoding: .utf8) } ?? "")
+            return
+        }
+        let response = task.response as? HTTPURLResponse
+        let statusCode = response?.statusCode ?? 0
+        let errorText = error.map { WsConnection.describe($0) } ?? "连接已断开"
+        if statusCode == 429 {
+            let retryAfter = WsConnection.parseRetryAfter(response?.value(forHTTPHeaderField: "Retry-After"))
+            self.fail429("HTTP 429 请求过于频繁", retryAfter: retryAfter)
+        } else if statusCode == 401 || statusCode == 403 {
+            self.fail("HTTP \(statusCode) 鉴权失败，请检查 Token / 鉴权方式")
+        } else if statusCode > 0 && statusCode != 101 {
+            self.fail("HTTP \(statusCode) " + errorText)
+        } else {
+            self.fail(errorText)
+        }
+    }
+
+    private func resetIfStable() {
+        if let openedAt = self.openedAt, Date().timeIntervalSince(openedAt) > 15.0 {
+            self.attempt = 0
+        }
+        self.openedAt = nil
+    }
+
+    private func fail(_ message: String) {
+        if self.closed {
+            return
+        }
+        self.resetIfStable()
+        self.attempt += 1
+        // 0.5s, 1s, 2s, 4s, 8s, 16s, cap 30s (+ jitter so many subs don't reconnect in lockstep)
+        let base: Double = self.attempt == 1 ? 0.5 : min(30.0, Double(1 << min(self.attempt - 2, 5)))
+        let delay = base + Double.random(in: 0.0 ..< 0.4)
+        self.notBefore = nil
+        self.schedule(message, delay: delay)
+    }
+
+    /// HTTP 429: honour Retry-After (capped), otherwise a short exponential backoff starting at 2s.
+    private func fail429(_ message: String, retryAfter: Double?) {
+        if self.closed {
+            return
+        }
+        self.resetIfStable()
+        self.attempt += 1
+        let backoff = min(30.0, Double(2 << min(self.attempt - 1, 4)))
+        var delay: Double
+        if let retryAfter = retryAfter {
+            delay = min(60.0, max(retryAfter, 1.0))
+        } else {
+            delay = backoff
+        }
+        delay += Double.random(in: 0.0 ..< 0.7)
+        self.notBefore = Date(timeIntervalSinceNow: delay)
+        self.schedule(message, delay: delay)
+    }
+
+    private func schedule(_ message: String, delay: Double) {
+        self.setState(.waiting, message + " · \(Int(delay.rounded(.up)))s 后重连")
+        self.scheduleRetry(after: delay)
+    }
+
+    private func scheduleRetry(after delay: Double) {
+        self.retryTimer?.invalidate()
+        let timer = Timer(timeInterval: max(0.0, delay), repeats: false, block: { [weak self] _ in
+            self?.connect()
+        })
+        RunLoop.main.add(timer, forMode: .common)
+        self.retryTimer = timer
+    }
+
+    private func setState(_ state: WsConnectionState, _ detail: String) {
+        self.state = state
+        self.onStatus?(state, detail)
+    }
+
+    // MARK: - Ping
+
+    private func startPing(_ task: URLSessionWebSocketTask) {
+        self.stopPing()
+        let timer = Timer(timeInterval: 25.0, repeats: true, block: { [weak self, weak task] _ in
+            guard let self = self, let task = task, self.task === task else {
+                return
+            }
+            task.sendPing(pongReceiveHandler: { [weak self] error in
+                guard let error = error else {
+                    return
+                }
+                DispatchQueue.main.async {
+                    guard let self = self, self.task === task else {
+                        return
+                    }
+                    task.cancel(with: .goingAway, reason: nil)
+                    self.handleFailure(task: task, error: error)
+                }
+            })
+        })
+        RunLoop.main.add(timer, forMode: .common)
+        self.pingTimer = timer
+    }
+
+    private func stopPing() {
+        self.pingTimer?.invalidate()
+        self.pingTimer = nil
+    }
+
+    // MARK: - Helpers
+
+    static func describe(_ error: Error) -> String {
+        let nsError = error as NSError
+        if nsError.domain == NSURLErrorDomain {
+            switch nsError.code {
+            case NSURLErrorTimedOut:
+                return "连接超时"
+            case NSURLErrorNotConnectedToInternet:
+                return "网络不可用"
+            case NSURLErrorCannotFindHost, NSURLErrorDNSLookupFailed:
+                return "无法解析域名"
+            case NSURLErrorCannotConnectToHost:
+                return "无法连接服务器"
+            case NSURLErrorNetworkConnectionLost:
+                return "网络连接中断"
+            case NSURLErrorSecureConnectionFailed, NSURLErrorServerCertificateUntrusted, NSURLErrorServerCertificateHasBadDate, NSURLErrorServerCertificateNotYetValid, NSURLErrorServerCertificateHasUnknownRoot:
+                return "TLS 握手失败"
+            case NSURLErrorBadServerResponse:
+                return "握手失败（服务器响应异常）"
+            default:
+                break
+            }
+        }
+        return nsError.localizedDescription
+    }
+
+    /// Retry-After as seconds ("120" or an HTTP date).
+    static func parseRetryAfter(_ value: String?) -> Double? {
+        guard let value = value?.trimmingCharacters(in: .whitespaces), !value.isEmpty else {
+            return nil
+        }
+        if let seconds = Double(value) {
+            return max(0.0, seconds)
+        }
+        let formatter = DateFormatter()
+        formatter.locale = Locale(identifier: "en_US_POSIX")
+        formatter.dateFormat = "EEE, dd MMM yyyy HH:mm:ss zzz"
+        if let date = formatter.date(from: value) {
+            return max(0.0, date.timeIntervalSinceNow)
+        }
+        return nil
+    }
+}
diff --git a/submodules/WsBridge/Sources/WsImageLoader.swift b/submodules/WsBridge/Sources/WsImageLoader.swift
new file mode 100644
index 00000000..37f2079e
--- /dev/null
+++ b/submodules/WsBridge/Sources/WsImageLoader.swift
@@ -0,0 +1,107 @@
+import Foundation
+import UIKit
+import ImageIO
+import TelegramCore
+
+/// Downloads message images in parallel and converts them into local photo representations.
+enum WsImageLoader {
+    private static let session: URLSession = {
+        let configuration = URLSessionConfiguration.default
+        configuration.timeoutIntervalForRequest = 30.0
+        configuration.timeoutIntervalForResource = 45.0
+        configuration.httpAdditionalHeaders = ["User-Agent": "Mozilla/5.0 (iPhone; CPU iPhone OS like Mac OS X) TelegramWS"]
+        configuration.httpMaximumConnectionsPerHost = 4
+        return URLSession(configuration: configuration)
+    }()
+
+    private static let processingQueue = DispatchQueue(label: "WsBridge.ImageProcessing", qos: .userInitiated, attributes: .concurrent)
+
+    /// Calls `completion` on the main queue with one entry per url (nil = failed), in the same order.
+    static func load(urls: [String], completion: @escaping ([WsLocalAccount.Image?]) -> Void) {
+        if urls.isEmpty {
+            completion([])
+            return
+        }
+        let lock = NSLock()
+        var results = [WsLocalAccount.Image?](repeating: nil, count: urls.count)
+        let group = DispatchGroup()
+        for (index, urlString) in urls.enumerated() {
+            guard let url = URL(string: urlString) else {
+                continue
+            }
+            group.enter()
+            let task = WsImageLoader.session.dataTask(with: url, completionHandler: { data, response, _ in
+                var ok = data != nil
+                if let response = response as? HTTPURLResponse, !(200 ..< 300).contains(response.statusCode) {
+                    ok = false
+                }
+                guard ok, let data = data else {
+                    group.leave()
+                    return
+                }
+                WsImageLoader.processingQueue.async {
+                    let image = WsImageLoader.makeImage(data: data)
+                    lock.lock()
+                    results[index] = image
+                    lock.unlock()
+                    group.leave()
+                }
+            })
+            task.resume()
+        }
+        group.notify(queue: .main) {
+            lock.lock()
+            let final = results
+            lock.unlock()
+            completion(final)
+        }
+    }
+
+    private static func makeImage(data: Data) -> WsLocalAccount.Image? {
+        guard let source = CGImageSourceCreateWithData(data as CFData, nil) else {
+            return nil
+        }
+        guard let full = WsImageLoader.scaled(source: source, maxPixelSize: 1280), let fullData = WsImageLoader.jpeg(full, quality: 0.87) else {
+            return nil
+        }
+        var thumbData: Data?
+        var thumbWidth: Int32 = 0
+        var thumbHeight: Int32 = 0
+        if let thumb = WsImageLoader.scaled(source: source, maxPixelSize: 320), let data = WsImageLoader.jpeg(thumb, quality: 0.7) {
+            thumbData = data
+            thumbWidth = Int32(thumb.width)
+            thumbHeight = Int32(thumb.height)
+        }
+        return WsLocalAccount.Image(data: fullData, width: Int32(full.width), height: Int32(full.height), thumbnailData: thumbData, thumbnailWidth: thumbWidth, thumbnailHeight: thumbHeight)
+    }
+
+    /// Decodes the first frame, applies EXIF orientation and downsamples to `maxPixelSize`.
+    private static func scaled(source: CGImageSource, maxPixelSize: Int) -> CGImage? {
+        let options: [CFString: Any] = [
+            kCGImageSourceCreateThumbnailFromImageAlways: true,
+            kCGImageSourceCreateThumbnailWithTransform: true,
+            kCGImageSourceShouldCacheImmediately: true,
+            kCGImageSourceThumbnailMaxPixelSize: maxPixelSize
+        ]
+        return CGImageSourceCreateThumbnailAtIndex(source, 0, options as CFDictionary)
+    }
+
+    private static func jpeg(_ image: CGImage, quality: CGFloat) -> Data? {
+        switch image.alphaInfo {
+        case .none, .noneSkipFirst, .noneSkipLast:
+            return UIImage(cgImage: image).jpegData(compressionQuality: quality)
+        default:
+            // transparent PNG/WebP: flatten onto white instead of letting JPEG turn it black
+            let size = CGSize(width: image.width, height: image.height)
+            let format = UIGraphicsImageRendererFormat()
+            format.scale = 1.0
+            format.opaque = true
+            let rendered = UIGraphicsImageRenderer(size: size, format: format).image { context in
+                UIColor.white.setFill()
+                context.fill(CGRect(origin: CGPoint(), size: size))
+                UIImage(cgImage: image).draw(in: CGRect(origin: CGPoint(), size: size))
+            }
+            return rendered.jpegData(compressionQuality: quality)
+        }
+    }
+}
diff --git a/submodules/WsBridge/Sources/WsKeepAlive.swift b/submodules/WsBridge/Sources/WsKeepAlive.swift
new file mode 100644
index 00000000..f2e64460
--- /dev/null
+++ b/submodules/WsBridge/Sources/WsKeepAlive.swift
@@ -0,0 +1,156 @@
+import Foundation
+import UIKit
+import AVFoundation
+
+/// Keeps the process running in the background by looping silent audio (UIBackgroundModes: audio),
+/// so WebSocket links and notifications stay live like the Android foreground service.
+/// Only active while the app is in the background and the user enabled it.
+final class WsKeepAlive {
+    static let shared = WsKeepAlive()
+
+    private var enabled = false
+    private var player: AVAudioPlayer?
+    private var watchdog: Timer?
+    private var observers: [NSObjectProtocol] = []
+    private var backgroundTask: UIBackgroundTaskIdentifier = .invalid
+
+    private init() {
+        let center = NotificationCenter.default
+        self.observers.append(center.addObserver(forName: UIApplication.didEnterBackgroundNotification, object: nil, queue: .main, using: { [weak self] _ in
+            self?.applicationDidEnterBackground()
+        }))
+        self.observers.append(center.addObserver(forName: UIApplication.willEnterForegroundNotification, object: nil, queue: .main, using: { [weak self] _ in
+            self?.stop()
+        }))
+        self.observers.append(center.addObserver(forName: AVAudioSession.interruptionNotification, object: nil, queue: .main, using: { [weak self] notification in
+            guard let self = self else {
+                return
+            }
+            let rawType = (notification.userInfo?[AVAudioSessionInterruptionTypeKey] as? NSNumber)?.uintValue ?? 0
+            if AVAudioSession.InterruptionType(rawValue: rawType) == .ended {
+                self.restartIfNeeded()
+            }
+        }))
+        self.observers.append(center.addObserver(forName: AVAudioSession.mediaServicesWereResetNotification, object: nil, queue: .main, using: { [weak self] _ in
+            self?.player = nil
+            self?.restartIfNeeded()
+        }))
+    }
+
+    var isEnabled: Bool {
+        return self.enabled
+    }
+
+    func setEnabled(_ enabled: Bool) {
+        if self.enabled == enabled {
+            return
+        }
+        self.enabled = enabled
+        if enabled {
+            if UIApplication.shared.applicationState == .background {
+                self.start()
+            }
+        } else {
+            self.stop()
+        }
+    }
+
+    private func applicationDidEnterBackground() {
+        guard self.enabled else {
+            return
+        }
+        // a short grace period in case the audio session needs a moment to come up
+        self.beginBackgroundTask()
+        self.start()
+    }
+
+    private func restartIfNeeded() {
+        guard self.enabled, UIApplication.shared.applicationState == .background else {
+            return
+        }
+        if self.player?.isPlaying != true {
+            self.start()
+        }
+    }
+
+    private func start() {
+        do {
+            let session = AVAudioSession.sharedInstance()
+            try session.setCategory(.playback, mode: .default, options: [.mixWithOthers])
+            try session.setActive(true, options: [])
+        } catch {
+        }
+        if self.player == nil {
+            self.player = try? AVAudioPlayer(data: WsKeepAlive.silentWav())
+            self.player?.numberOfLoops = -1
+            self.player?.volume = 0.0
+            self.player?.prepareToPlay()
+        }
+        if self.player?.isPlaying != true {
+            self.player?.play()
+        }
+        if self.watchdog == nil {
+            let timer = Timer(timeInterval: 10.0, repeats: true, block: { [weak self] _ in
+                self?.restartIfNeeded()
+            })
+            RunLoop.main.add(timer, forMode: .common)
+            self.watchdog = timer
+        }
+    }
+
+    private func stop() {
+        self.watchdog?.invalidate()
+        self.watchdog = nil
+        if let player = self.player {
+            player.stop()
+            self.player = nil
+            try? AVAudioSession.sharedInstance().setActive(false, options: [.notifyOthersOnDeactivation])
+        }
+        self.endBackgroundTask()
+    }
+
+    private func beginBackgroundTask() {
+        self.endBackgroundTask()
+        self.backgroundTask = UIApplication.shared.beginBackgroundTask(withName: "WsKeepAlive", expirationHandler: { [weak self] in
+            self?.endBackgroundTask()
+        })
+    }
+
+    private func endBackgroundTask() {
+        if self.backgroundTask != .invalid {
+            UIApplication.shared.endBackgroundTask(self.backgroundTask)
+            self.backgroundTask = .invalid
+        }
+    }
+
+    /// One second of 8 kHz / 16-bit mono silence as a WAV file.
+    private static func silentWav() -> Data {
+        let sampleRate: UInt32 = 8000
+        let samples = Int(sampleRate)
+        let dataSize = UInt32(samples * 2)
+        var data = Data()
+        func append32(_ value: UInt32) {
+            var v = value.littleEndian
+            withUnsafeBytes(of: &v) { data.append(contentsOf: $0) }
+        }
+        func append16(_ value: UInt16) {
+            var v = value.littleEndian
+            withUnsafeBytes(of: &v) { data.append(contentsOf: $0) }
+        }
+        data.append(contentsOf: Array("RIFF".utf8))
+        append32(36 + dataSize)
+        data.append(contentsOf: Array("WAVE".utf8))
+        data.append(contentsOf: Array("fmt ".utf8))
+        append32(16)
+        append16(1)
+        append16(1)
+        append32(sampleRate)
+        append32(sampleRate * 2)
+        append16(2)
+        append16(16)
+        data.append(contentsOf: Array("data".utf8))
+        append32(dataSize)
+        data.append(Data(count: Int(dataSize)))
+        return data
+    }
+}
diff --git a/submodules/WsBridge/Sources/WsNotifier.swift b/submodules/WsBridge/Sources/WsNotifier.swift
new file mode 100644
index 00000000..5af87e77
--- /dev/null
+++ b/submodules/WsBridge/Sources/WsNotifier.swift
@@ -0,0 +1,131 @@
+import Foundation
+import UIKit
+import UserNotifications
+import SwiftSignalKit
+import TelegramCore
+import AccountContext
+
+/// Immediate local notifications for WebSocket frames, posted the moment a frame is parsed
+/// (before image downloads and database writes). One notification per channel is kept and
+/// updated (like the Android InboxStyle notification), and the sound plays at most once per
+/// `alertWindow` per channel so a replay burst does not ring hundreds of times.
+public final class WsNotifier {
+    public static let shared = WsNotifier()
+
+    static let userInfoKey = "wsbridge"
+    private static let alertWindow: TimeInterval = 2.0
+    private static let maxLines = 6
+
+    private struct DialogState {
+        var lines: [String] = []
+        var unread: Int = 0
+        var lastAlertAt: Date?
+    }
+
+    private var dialogs: [Int64: DialogState] = [:]
+    private var requestedAuthorization = false
+    private var observer: NSObjectProtocol?
+
+    private init() {
+        self.observer = NotificationCenter.default.addObserver(forName: UIApplication.didBecomeActiveNotification, object: nil, queue: .main, using: { [weak self] _ in
+            // the user is looking at the app now: start counting from scratch
+            self?.dialogs.removeAll()
+        })
+    }
+
+    /// Foreground presentation for WebSocket notifications (Telegram itself hides foreground notifications).
+    public static func foregroundPresentationOptions(for notification: UNNotification) -> UNNotificationPresentationOptions? {
+        if notification.request.content.userInfo[WsNotifier.userInfoKey] == nil {
+            return nil
+        }
+        return [.banner, .list, .sound]
+    }
+
+    func requestAuthorizationIfNeeded() {
+        if self.requestedAuthorization {
+            return
+        }
+        self.requestedAuthorization = true
+        UNUserNotificationCenter.current().requestAuthorization(options: [.alert, .sound, .badge], completionHandler: { _, _ in
+        })
+    }
+
+    /// Main queue only.
+    func notify(context: AccountContext, peerId: EnginePeer.Id, title: String, sender: String?, text: String, imageCount: Int, ignoreMute: Bool = false) {
+        let accountId = context.account.id.int64
+        let post: () -> Void = { [weak self] in
+            self?.post(accountId: accountId, peerId: peerId, title: title, sender: sender, text: text, imageCount: imageCount)
+        }
+        if ignoreMute {
+            post()
+            return
+        }
+        let _ = (context.engine.data.get(TelegramEngine.EngineData.Item.Peer.NotificationSettings(id: peerId))
+        |> take(1)
+        |> deliverOnMainQueue).start(next: { settings in
+            if case let .muted(until) = settings.muteState, until > Int32(Date().timeIntervalSince1970) {
+                return
+            }
+            post()
+        })
+    }
+
+    private func post(accountId: Int64, peerId: EnginePeer.Id, title: String, sender: String?, text: String, imageCount: Int) {
+        let key = peerId.toInt64()
+        var state = self.dialogs[key] ?? DialogState()
+        state.lines.append(WsNotifier.preview(sender: sender, text: text, imageCount: imageCount))
+        if state.lines.count > WsNotifier.maxLines {
+            state.lines.removeFirst(state.lines.count - WsNotifier.maxLines)
+        }
+        state.unread += 1
+        let now = Date()
+        var playSound = true
+        if let lastAlertAt = state.lastAlertAt, now.timeIntervalSince(lastAlertAt) < WsNotifier.alertWindow {
+            playSound = false
+        } else {
+            state.lastAlertAt = now
+        }
+        self.dialogs[key] = state
+
+        let content = UNMutableNotificationContent()
+        content.title = title.isEmpty ? "WebSocket" : title
+        if state.unread > 1 {
+            content.subtitle = "\(state.unread) 条新消息"
+            content.body = state.lines.suffix(4).joined(separator: "\n")
+        } else {
+            content.body = state.lines.last ?? ""
+        }
+        content.threadIdentifier = "ws-\(key)"
+        content.categoryIdentifier = "ws"
+        if playSound {
+            content.sound = .default
+        }
+        content.userInfo = [
+            WsNotifier.userInfoKey: 1,
+            "accountId": NSNumber(value: accountId),
+            "peerId": NSNumber(value: key)
+        ]
+        content.interruptionLevel = .timeSensitive
+        content.relevanceScore = 1.0
+        // same identifier per channel: the notification is updated in place instead of stacking up
+        let request = UNNotificationRequest(identifier: "ws-\(key)", content: content, trigger: nil)
+        UNUserNotificationCenter.current().add(request, withCompletionHandler: nil)
+    }
+
+    static func preview(sender: String?, text: String, imageCount: Int) -> String {
+        var t = WsParser.trim(text.replacingOccurrences(of: "\n", with: " "))
+        if t.count > 300 {
+            t = String(t.prefix(300)) + "…"
+        }
+        if imageCount > 0 {
+            t = (imageCount > 1 ? "[\(imageCount) 张图片] " : "[图片] ") + t
+        }
+        if WsParser.trim(t).isEmpty {
+            t = "新消息"
+        }
+        if let sender = sender, !sender.isEmpty {
+            t = sender + "：" + t
+        }
+        return WsParser.trim(t)
+    }
+}
diff --git a/submodules/WsBridge/Sources/WsParser.swift b/submodules/WsBridge/Sources/WsParser.swift
new file mode 100644
index 00000000..5025e329
--- /dev/null
+++ b/submodules/WsBridge/Sources/WsParser.swift
@@ -0,0 +1,371 @@
+import Foundation
+
+/// Turns raw WebSocket frames (plain text or lianyun-style JSON EVENT) into message parts.
+/// Port of the Android `WsParser`.
+public enum WsParser {
+    public enum Kind: Equatable {
+        case message
+        case connected
+        case ping
+        case ignore
+    }
+
+    public struct Result {
+        public var kind: Kind = .message
+        public var sender: String?
+        /// actions.bloggerName (or 【...】 prefix of content). Preferred dialog key over sender.
+        public var blogger: String?
+        public var eventType: String?
+        public var text: String = ""
+        public var images: [String] = []
+        public var timeMs: Int64 = 0
+        public var uid: String?
+        /// Relay server sequence number (tgpush); 0 when absent. Used to resume with ?since=.
+        public var seq: Int64 = 0
+
+        public init() {
+        }
+    }
+
+    private static let contentKeys = ["content", "text", "message", "body", "msg"]
+    private static let senderKeys = ["senderName", "sender", "author", "nickname", "nickName", "userName", "username", "blogger", "channelName", "from"]
+    private static let idKeys = ["notificationId", "id", "messageId", "msgId", "uuid"]
+    private static let bloggerKeys = ["bloggerName", "blogger", "bloggerNickname", "kolName"]
+    private static let imageKeys = ["images", "imageUrls", "pics", "pictures", "photos", "image", "imageUrl", "pic", "img"]
+
+    private static let mdImage = try! NSRegularExpression(pattern: "!\\[([^\\]]*)]\\((https?://[^)\\s]+)\\)", options: [])
+    private static let mdLink = try! NSRegularExpression(pattern: "\\[([^\\]]+)]\\((https?://[^)\\s]+)\\)", options: [])
+    private static let bareImage = try! NSRegularExpression(pattern: "(?<![(\"])(https?://[^\\s<>\\[\\]()\"']+\\.(?:png|jpe?g|webp|gif)(?:\\?[^\\s<>\\[\\]()\"']*)?)", options: [.caseInsensitive])
+    private static let bracketName = try! NSRegularExpression(pattern: "^\\s*【([^】\\n]{1,64})】", options: [])
+    private static let boldMarkup = try! NSRegularExpression(pattern: "(\\*\\*|__)(.+?)\\1", options: [])
+    private static let trailingSpaces = try! NSRegularExpression(pattern: "[ \\t]+\\n", options: [])
+    private static let manyNewlines = try! NSRegularExpression(pattern: "\\n{3,}", options: [])
+    private static let longFraction = try! NSRegularExpression(pattern: "(\\.\\d{3})\\d+", options: [])
+
+    public static func parse(_ raw: String) -> Result {
+        var r = Result()
+        var t = trim(raw)
+        if t.isEmpty {
+            r.kind = .ignore
+            return r
+        }
+        if !t.hasPrefix("{") {
+            let lower = t.lowercased()
+            if lower == "ping" || lower == "pong" {
+                r.kind = .ping
+                return r
+            }
+            fillText(&r, content: t, extra: nil)
+            return r
+        }
+        guard var o = jsonObject(t) else {
+            fillText(&r, content: t, extra: nil)
+            return r
+        }
+        r.seq = int64(o["seq"]) ?? 0
+        let type = str(o, "type") ?? ""
+        if type.caseInsensitiveCompare("CONNECTED") == .orderedSame {
+            r.kind = .connected
+            return r
+        }
+        if type.caseInsensitiveCompare("PING") == .orderedSame || type.caseInsensitiveCompare("PONG") == .orderedSame || type.caseInsensitiveCompare("HEARTBEAT") == .orderedSame {
+            r.kind = .ping
+            return r
+        }
+
+        var p: [String: Any] = (o["payload"] as? [String: Any]) ?? (o["data"] as? [String: Any]) ?? o
+        var content = first(p, contentKeys) ?? first(o, contentKeys)
+        r.sender = first(p, senderKeys)
+        r.blogger = findBlogger([p, o])
+        r.eventType = first(p, ["eventType"]) ?? str(o, "eventType")
+        r.uid = first(p, idKeys) ?? first(o, idKeys)
+        let ts = str(o, "occurredAt") ?? str(p, "occurredAt") ?? str(p, "createdAt") ?? str(p, "time") ?? str(o, "timestamp")
+        r.timeMs = parseTime(ts)
+
+        // lianyun "message.created" frames carry the real notification as a JSON *string* in content
+        // (schema lianyun.assistant.notification: eventType / content / actions.bloggerName ...).
+        var depth = 0
+        while depth < 3, let c = content, trim(c).hasPrefix("{") {
+            depth += 1
+            guard let inner = jsonObject(trim(c)) else {
+                break
+            }
+            p = inner
+            var ic = first(inner, contentKeys)
+            if ic == nil {
+                if let ip = (inner["payload"] as? [String: Any]) ?? (inner["data"] as? [String: Any]) {
+                    p = ip
+                    ic = first(ip, contentKeys)
+                }
+            }
+            if let ib = findBlogger([p, inner]) {
+                r.blogger = ib
+            }
+            if let isender = first(p, senderKeys) {
+                r.sender = isender
+            }
+            if let iid = first(inner, idKeys) {
+                r.uid = iid
+            }
+            if let iet = str(inner, "eventType") {
+                r.eventType = iet
+            }
+            let it = parseTime(str(inner, "occurredAt"))
+            if it > 0 {
+                r.timeMs = it
+            }
+            if ic == nil {
+                content = nil
+                o = inner
+                t = jsonString(inner) ?? t
+                break
+            }
+            content = ic
+        }
+
+        if r.uid == nil {
+            // RAW + SIGNAL events can share one source message: keep both by including the event type
+            let a = (p["actions"] as? [String: Any]) ?? (o["actions"] as? [String: Any])
+            if let a = a, let smid = str(a, "sourceMessageId") {
+                r.uid = smid + "|" + (r.eventType ?? "")
+            }
+        }
+        if r.blogger == nil, let content = content {
+            if let name = firstGroup(bracketName, in: content) {
+                r.blogger = trim(name)
+            }
+        }
+        if let blogger = r.blogger, blogger.isEmpty {
+            r.blogger = nil
+        }
+
+        var extra: [String] = []
+        for k in imageKeys {
+            if let array = p[k] as? [Any] {
+                for e in array {
+                    var u: String?
+                    if let eo = e as? [String: Any] {
+                        u = eo["url"] as? String
+                    } else {
+                        u = scalarString(e)
+                    }
+                    if let u = u, u.hasPrefix("http") {
+                        extra.append(u)
+                    }
+                }
+            } else if let s = p[k] as? String, s.hasPrefix("http") {
+                extra.append(s)
+            }
+        }
+
+        if content == nil && extra.isEmpty {
+            let keys = Array(o.keys.sorted().prefix(5)).joined(separator: ", ")
+            let snippet = t.count > 800 ? String(t.prefix(800)) : t
+            r.text = "（JSON · " + keys + "）\n" + snippet
+            return r
+        }
+        fillText(&r, content: content ?? "", extra: extra)
+        return r
+    }
+
+    private static func fillText(_ r: inout Result, content: String, extra: [String]?) {
+        var imgs: [String] = []
+        func addImage(_ u: String) {
+            if !imgs.contains(u) {
+                imgs.append(u)
+            }
+        }
+        let ns = content as NSString
+        for m in mdImage.matches(in: content, options: [], range: NSRange(location: 0, length: ns.length)) {
+            addImage(ns.substring(with: m.range(at: 2)))
+        }
+        for m in bareImage.matches(in: content, options: [], range: NSRange(location: 0, length: ns.length)) {
+            addImage(ns.substring(with: m.range(at: 1)))
+        }
+        if let extra = extra {
+            for u in extra {
+                addImage(u)
+            }
+        }
+
+        var s = replace(mdImage, in: content, with: "")
+
+        // [label](url) -> "label url" (or just url)
+        let sns = s as NSString
+        var out = ""
+        var last = 0
+        for m in mdLink.matches(in: s, options: [], range: NSRange(location: 0, length: sns.length)) {
+            out += sns.substring(with: NSRange(location: last, length: m.range.location - last))
+            let label = trim(sns.substring(with: m.range(at: 1)))
+            let url = sns.substring(with: m.range(at: 2))
+            out += (!label.isEmpty && label != url) ? (label + " " + url) : url
+            last = m.range.location + m.range.length
+        }
+        out += sns.substring(from: last)
+        s = out
+
+        for u in imgs {
+            s = s.replacingOccurrences(of: u, with: "")
+        }
+        s = replace(boldMarkup, in: s, with: "$2")
+        s = replace(trailingSpaces, in: s, with: "\n")
+        s = replace(manyNewlines, in: s, with: "\n\n")
+        r.text = trim(s)
+        r.images.append(contentsOf: imgs)
+    }
+
+    /// bloggerName from actions / card / payload / root, first match wins.
+    private static func findBlogger(_ objs: [[String: Any]]) -> String? {
+        for x in objs {
+            for holder in ["actions", "card", "meta", "extra"] {
+                if let h = x[holder] as? [String: Any], let v = first(h, bloggerKeys) {
+                    return trim(v)
+                }
+            }
+            if let v = first(x, bloggerKeys) {
+                return trim(v)
+            }
+        }
+        return nil
+    }
+
+    // MARK: - JSON helpers (org.json semantics)
+
+    private static func jsonObject(_ text: String) -> [String: Any]? {
+        guard let data = text.data(using: .utf8) else {
+            return nil
+        }
+        return (try? JSONSerialization.jsonObject(with: data, options: [])) as? [String: Any]
+    }
+
+    private static func jsonString(_ object: [String: Any]) -> String? {
+        guard let data = try? JSONSerialization.data(withJSONObject: object, options: []) else {
+            return nil
+        }
+        return String(data: data, encoding: .utf8)
+    }
+
+    /// String value of a JSON scalar; nil for null / objects / arrays.
+    private static func scalarString(_ value: Any?) -> String? {
+        guard let value = value else {
+            return nil
+        }
+        if value is NSNull || value is [Any] || value is [String: Any] {
+            return nil
+        }
+        if let s = value as? String {
+            return s
+        }
+        if let n = value as? NSNumber {
+            return n.stringValue
+        }
+        if let i = value as? Int {
+            return String(i)
+        }
+        if let d = value as? Double {
+            return String(d)
+        }
+        if let b = value as? Bool {
+            return b ? "true" : "false"
+        }
+        return "\(value)"
+    }
+
+    private static func str(_ o: [String: Any], _ key: String) -> String? {
+        guard let s = scalarString(o[key]) else {
+            return nil
+        }
+        return trim(s).isEmpty ? nil : s
+    }
+
+    private static func first(_ o: [String: Any], _ keys: [String]) -> String? {
+        for k in keys {
+            if let v = str(o, k) {
+                return v
+            }
+        }
+        return nil
+    }
+
+    private static func int64(_ value: Any?) -> Int64? {
+        if let n = value as? NSNumber {
+            return n.int64Value
+        }
+        if let i = value as? Int {
+            return Int64(i)
+        }
+        if let d = value as? Double {
+            return Int64(d)
+        }
+        if let s = value as? String {
+            return Int64(trim(s))
+        }
+        return nil
+    }
+
+    // MARK: - String helpers
+
+    /// java.lang.String.trim(): strips characters <= U+0020.
+    static func trim(_ s: String) -> String {
+        let scalars = s.unicodeScalars
+        guard let start = scalars.firstIndex(where: { $0.value > 0x20 }) else {
+            return ""
+        }
+        let end = scalars.lastIndex(where: { $0.value > 0x20 })!
+        return String(scalars[start ... end])
+    }
+
+    private static func replace(_ regex: NSRegularExpression, in s: String, with template: String) -> String {
+        return regex.stringByReplacingMatches(in: s, options: [], range: NSRange(location: 0, length: (s as NSString).length), withTemplate: template)
+    }
+
+    private static func firstGroup(_ regex: NSRegularExpression, in s: String) -> String? {
+        let ns = s as NSString
+        guard let m = regex.firstMatch(in: s, options: [], range: NSRange(location: 0, length: ns.length)), m.range(at: 1).location != NSNotFound else {
+            return nil
+        }
+        return ns.substring(with: m.range(at: 1))
+    }
+
+    // MARK: - Time
+
+    private static let isoWithFraction: ISO8601DateFormatter = {
+        let f = ISO8601DateFormatter()
+        f.formatOptions = [.withInternetDateTime, .withFractionalSeconds]
+        return f
+    }()
+
+    private static let isoPlain: ISO8601DateFormatter = {
+        let f = ISO8601DateFormatter()
+        f.formatOptions = [.withInternetDateTime]
+        return f
+    }()
+
+    private static let shanghaiFormatter: DateFormatter = {
+        let f = DateFormatter()
+        f.locale = Locale(identifier: "en_US_POSIX")
+        f.timeZone = TimeZone(identifier: "Asia/Shanghai")
+        f.dateFormat = "yyyy-MM-dd HH:mm:ss"
+        return f
+    }()
+
+    /// Epoch milliseconds, 0 if unknown. Accepts epoch seconds/millis, ISO-8601 and "yyyy-MM-dd HH:mm:ss" (UTC+8).
+    public static func parseTime(_ value: String?) -> Int64 {
+        guard let value = value else {
+            return 0
+        }
+        let s = trim(value)
+        if let v = Int64(s) {
+            return v < 10_000_000_000 ? v * 1000 : v
+        }
+        let norm = replace(longFraction, in: s, with: "$1")
+        if let d = isoWithFraction.date(from: norm) ?? isoPlain.date(from: norm) ?? shanghaiFormatter.date(from: norm) {
+            return Int64((d.timeIntervalSince1970 * 1000.0).rounded())
+        }
+        // SimpleDateFormat is lenient about trailing text ("2024-01-01 10:00:00.123")
+        if norm.count > 19, let d = shanghaiFormatter.date(from: String(norm.prefix(19))) {
+            return Int64((d.timeIntervalSince1970 * 1000.0).rounded())
+        }
+        return 0
+    }
+}
