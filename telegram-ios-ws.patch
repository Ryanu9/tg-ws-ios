+++ b/submodules/WsBridge/Sources/WsStore.swift
@@ -0,0 +1,161 @@
+import Foundation
+
+/// Persistent bridge settings: subscriptions, relay sequence numbers and the de-duplication window.
+/// Not thread-safe: used from the main queue only.
+public final class WsStore {
+    public static let shared = WsStore(defaults: .standard)
+
+    private static let maxSeenPerSubscription = 1500
+
+    private let defaults: UserDefaults
+    private var seenOrder: [String: [String]] = [:]
+    private var seenSet: [String: Set<String>] = [:]
+    private var seenDirty = Set<String>()
+    private var seenPersistScheduled = false
+
+    public init(defaults: UserDefaults) {
+        self.defaults = defaults
+    }
+
+    // MARK: - Subscriptions
+
+    public var subscriptions: [WsSubscription] {
+        get {
+            guard let data = self.defaults.data(forKey: "wsbridge.subs") else {
+                // no built-in endpoint: the user adds subscriptions themselves
+                return []
+            }
+            return (try? JSONDecoder().decode([WsSubscription].self, from: data)) ?? []
+        }
+        set {
+            if let data = try? JSONEncoder().encode(newValue) {
+                self.defaults.set(data, forKey: "wsbridge.subs")
+            }
+        }
+    }
+
+    public func subscription(id: String) -> WsSubscription? {
+        return self.subscriptions.first(where: { $0.id == id })
+    }
+
+    public func upsert(_ subscription: WsSubscription) {
+        var list = self.subscriptions
+        if let index = list.firstIndex(where: { $0.id == subscription.id }) {
+            list[index] = subscription
+        } else {
+            list.append(subscription)
+        }
+        self.subscriptions = list
+    }
+
+    public func remove(id: String) {
+        self.subscriptions = self.subscriptions.filter { $0.id != id }
+    }
+
+    // MARK: - Switches
+
+    public var serviceEnabled: Bool {
+        get {
+            return (self.defaults.object(forKey: "wsbridge.service") as? Bool) ?? true
+        }
+        set {
+            self.defaults.set(newValue, forKey: "wsbridge.service")
+        }
+    }
+
+    /// Keep the process alive in the background (silent audio) so sockets and notifications stay live.
+    public var keepAliveEnabled: Bool {
+        get {
+            return (self.defaults.object(forKey: "wsbridge.keepalive") as? Bool) ?? true
+        }
+        set {
+            self.defaults.set(newValue, forKey: "wsbridge.keepalive")
+        }
+    }
+
+    // MARK: - Relay sequence (tgpush `?since=`)
+
+    /// Highest relay seq received for this subscription + URL (a different server starts from scratch).
+    private func seqKey(_ subscription: WsSubscription) -> String {
+        return "wsbridge.seq_\(subscription.id)_\(String(UInt32(bitPattern: WsStore.javaHash(subscription.trimmedUrl)), radix: 16))"
+    }
+
+    public func lastSeq(_ subscription: WsSubscription) -> Int64 {
+        let value = self.defaults.object(forKey: self.seqKey(subscription))
+        if let number = value as? NSNumber {
+            return number.int64Value
+        } else if let number = value as? Int64 {
+            return number
+        } else if let number = value as? Int {
+            return Int64(number)
+        }
+        return 0
+    }
+
+    public func updateSeq(_ subscription: WsSubscription, _ seq: Int64) {
+        if seq > self.lastSeq(subscription) {
+            self.defaults.set(NSNumber(value: seq), forKey: self.seqKey(subscription))
+        }
+    }
+
+    // MARK: - De-duplication
+
+    /// Returns true if `uid` was already received for this subscription (and records it otherwise).
+    public func checkAndMarkSeen(subscriptionId: String, uid: String?) -> Bool {
+        guard let uid = uid, !uid.isEmpty else {
+            return false
+        }
+        if self.seenSet[subscriptionId] == nil {
+            let stored = self.defaults.stringArray(forKey: "wsbridge.uid_\(subscriptionId)") ?? []
+            self.seenOrder[subscriptionId] = stored
+            self.seenSet[subscriptionId] = Set(stored)
+        }
+        if self.seenSet[subscriptionId]!.contains(uid) {
+            return true
+        }
+        self.seenSet[subscriptionId]!.insert(uid)
+        self.seenOrder[subscriptionId]!.append(uid)
+        let overflow = self.seenOrder[subscriptionId]!.count - WsStore.maxSeenPerSubscription
+        if overflow > 0 {
+            let removed = self.seenOrder[subscriptionId]!.prefix(overflow)
+            for item in removed {
+                self.seenSet[subscriptionId]!.remove(item)
+            }
+            self.seenOrder[subscriptionId]!.removeFirst(overflow)
+        }
+        self.seenDirty.insert(subscriptionId)
+        self.schedulePersistSeen()
+        return false
+    }
+
+    private func schedulePersistSeen() {
+        if self.seenPersistScheduled {
+            return
+        }
+        self.seenPersistScheduled = true
+        DispatchQueue.main.asyncAfter(deadline: .now() + 1.0) { [weak self] in
+            self?.persistSeen()
+        }
+    }
+
+    public func persistSeen() {
+        self.seenPersistScheduled = false
+        for subscriptionId in self.seenDirty {
+            if let order = self.seenOrder[subscriptionId] {
+                self.defaults.set(order, forKey: "wsbridge.uid_\(subscriptionId)")
+            }
+        }
+        self.seenDirty.removeAll()
+    }
+
+    // MARK: - Helpers
+
+    /// java.lang.String.hashCode()
+    public static func javaHash(_ string: String) -> Int32 {
+        var h: Int32 = 0
+        for unit in string.utf16 {
+            h = h &* 31 &+ Int32(unit)
+        }
+        return h
+    }
+}
diff --git a/submodules/WsBridge/Sources/WsSubscription.swift b/submodules/WsBridge/Sources/WsSubscription.swift
