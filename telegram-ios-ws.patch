+import Foundation
+import UIKit
+import UserNotifications
+import TelegramCore
+import AccountContext
+
+/// Entry points used by the chat list and the settings screen.
+public enum WsBridgeUI {
+    public static func isLocalAccount(_ context: AccountContext) -> Bool {
+        return WsLocalAccount.isLocal(context.account.peerId)
+    }
+
+    public static func openSettings(context: AccountContext) {
+        let navigationController = UINavigationController(rootViewController: WsSettingsController())
+        navigationController.modalPresentationStyle = .formSheet
+        context.sharedContext.applicationBindings.presentNativeController(navigationController)
+    }
+}
+
+/// "WebSocket 订阅": service switches, subscription list with live status, actions.
+final class WsSettingsController: UITableViewController {
+    private enum Section: Int, CaseIterable {
+        case service
+        case subscriptions
+        case actions
+    }
+
+    private let bridge = WsBridgeManager.shared
+    private var subscriptions: [WsSubscription] = []
+    private var statusObserver: NSObjectProtocol?
+
+    init() {
+        super.init(style: .insetGrouped)
+    }
+
+    required init?(coder: NSCoder) {
+        fatalError("init(coder:) has not been implemented")
+    }
+
+    deinit {
+        if let statusObserver = self.statusObserver {
+            NotificationCenter.default.removeObserver(statusObserver)
+        }
+    }
+
+    override func viewDidLoad() {
+        super.viewDidLoad()
+        self.title = "WebSocket 订阅"
+        self.navigationItem.rightBarButtonItem = UIBarButtonItem(barButtonSystemItem: .done, target: self, action: #selector(self.donePressed))
+        self.statusObserver = NotificationCenter.default.addObserver(forName: WsBridgeManager.statusDidChangeNotification, object: nil, queue: .main, using: { [weak self] _ in
+            self?.reload()
+        })
+    }
+
+    override func viewWillAppear(_ animated: Bool) {
+        super.viewWillAppear(animated)
+        self.reload()
+    }
+
+    private func reload() {
+        self.subscriptions = self.bridge.store.subscriptions
+        self.tableView.reloadData()
+    }
+
+    @objc private func donePressed() {
+        self.dismiss(animated: true, completion: nil)
+    }
+
+    // MARK: - Table
+
+    override func numberOfSections(in tableView: UITableView) -> Int {
+        return Section.allCases.count
+    }
+
+    override func tableView(_ tableView: UITableView, numberOfRowsInSection section: Int) -> Int {
+        switch Section(rawValue: section)! {
+        case .service:
+            return 3
+        case .subscriptions:
+            return self.subscriptions.count + 1
+        case .actions:
+            return 3
+        }
+    }
+
+    override func tableView(_ tableView: UITableView, titleForHeaderInSection section: Int) -> String? {
+        switch Section(rawValue: section)! {
+        case .service:
+            return "接收消息"
+        case .subscriptions:
+            return "订阅"
+        case .actions:
+            return "通知"
+        }
+    }
+
+    override func tableView(_ tableView: UITableView, titleForFooterInSection section: Int) -> String? {
+        switch Section(rawValue: section)! {
+        case .service:
+            return "开启「后台保活」后，App 切到后台时会循环播放静音音频，保持 WebSocket 连接和即时通知（会增加耗电）。关闭时 iOS 会在切到后台约 30 秒后暂停连接，回到前台自动补收离线期间的消息。"
+        case .subscriptions:
+            return "每个订阅（开启拆分时为每个博主）对应聊天列表里的一个频道。"
+        case .actions:
+            return nil
+        }
+    }
+
+    override func tableView(_ tableView: UITableView, cellForRowAt indexPath: IndexPath) -> UITableViewCell {
+        switch Section(rawValue: indexPath.section)! {
+        case .service:
+            switch indexPath.row {
+            case 0:
+                return self.switchCell(title: "启用 WebSocket 接收", isOn: self.bridge.store.serviceEnabled, action: #selector(self.serviceSwitchChanged(_:)))
+            case 1:
+                let cell = UITableViewCell(style: .value1, reuseIdentifier: nil)
+                cell.textLabel?.text = "连接状态"
+                cell.selectionStyle = .none
+                if !self.bridge.store.serviceEnabled {
+                    cell.detailTextLabel?.text = "已关闭"
+                } else if self.bridge.activeCount == 0 {
+                    cell.detailTextLabel?.text = "无可用订阅"
+                } else {
+                    cell.detailTextLabel?.text = "已连接 \(self.bridge.connectedCount)/\(self.bridge.activeCount)"
+                    cell.detailTextLabel?.textColor = self.bridge.connectedCount == self.bridge.activeCount ? .systemGreen : .systemOrange
+                }
+                return cell
+            default:
+                return self.switchCell(title: "后台保活（静音音频）", isOn: self.bridge.store.keepAliveEnabled, action: #selector(self.keepAliveSwitchChanged(_:)))
+            }
+        case .subscriptions:
+            if indexPath.row < self.subscriptions.count {
+                let subscription = self.subscriptions[indexPath.row]
+                let cell = UITableViewCell(style: .subtitle, reuseIdentifier: nil)
+                cell.textLabel?.text = subscription.displayName
+                cell.accessoryType = .disclosureIndicator
+                cell.detailTextLabel?.numberOfLines = 2
+                let (text, color) = self.statusText(for: subscription)
+                cell.detailTextLabel?.text = text
+                cell.detailTextLabel?.textColor = color
+                return cell
+            } else {
+                let cell = UITableViewCell(style: .default, reuseIdentifier: nil)
+                cell.textLabel?.text = "添加订阅"
+                cell.textLabel?.textColor = self.view.tintColor
+                cell.imageView?.image = UIImage(systemName: "plus.circle.fill")
+                return cell
+            }
+        case .actions:
+            let cell = UITableViewCell(style: .default, reuseIdentifier: nil)
+            cell.textLabel?.textColor = self.view.tintColor
+            switch indexPath.row {
+            case 0:
+                cell.textLabel?.text = "立即重连"
+            case 1:
+                cell.textLabel?.text = "测试通知"
+            default:
+                cell.textLabel?.text = "系统通知设置"
+            }
+            return cell
+        }
+    }
+
+    override func tableView(_ tableView: UITableView, canEditRowAt indexPath: IndexPath) -> Bool {
+        return indexPath.section == Section.subscriptions.rawValue && indexPath.row < self.subscriptions.count
+    }
+
+    override func tableView(_ tableView: UITableView, titleForDeleteConfirmationButtonForRowAt indexPath: IndexPath) -> String? {
+        return "删除"
+    }
+
+    override func tableView(_ tableView: UITableView, commit editingStyle: UITableViewCell.EditingStyle, forRowAt indexPath: IndexPath) {
+        guard editingStyle == .delete, indexPath.row < self.subscriptions.count else {
+            return
+        }
+        let subscription = self.subscriptions[indexPath.row]
+        self.bridge.store.remove(id: subscription.id)
+        self.subscriptions = self.bridge.store.subscriptions
+        tableView.deleteRows(at: [indexPath], with: .automatic)
+        self.bridge.start()
+    }
+
+    override func tableView(_ tableView: UITableView, didSelectRowAt indexPath: IndexPath) {
+        tableView.deselectRow(at: indexPath, animated: true)
+        switch Section(rawValue: indexPath.section)! {
+        case .service:
+            break
+        case .subscriptions:
+            let subscription: WsSubscription? = indexPath.row < self.subscriptions.count ? self.subscriptions[indexPath.row] : nil
+            self.navigationController?.pushViewController(WsSubscriptionEditController(subscription: subscription), animated: true)
+        case .actions:
+            switch indexPath.row {
+            case 0:
+                self.bridge.reconnectNow()
+            case 1:
+                self.sendTestNotification()
+            default:
+                if let url = URL(string: UIApplication.openSettingsURLString) {
+                    UIApplication.shared.open(url, options: [:], completionHandler: nil)
+                }
+            }
+        }
+    }
+
+    // MARK: - Helpers
+
+    private func switchCell(title: String, isOn: Bool, action: Selector) -> UITableViewCell {
+        let cell = UITableViewCell(style: .default, reuseIdentifier: nil)
+        cell.textLabel?.text = title
+        cell.selectionStyle = .none
+        let control = UISwitch()
+        control.isOn = isOn
+        control.addTarget(self, action: action, for: .valueChanged)
+        cell.accessoryView = control
+        return cell
+    }
+
+    private func statusText(for subscription: WsSubscription) -> (String, UIColor) {
+        let host = URL(string: subscription.trimmedUrl)?.host ?? subscription.trimmedUrl
+        if !subscription.enabled {
+            return ("已停用 · " + host, .secondaryLabel)
+        }
+        if subscription.trimmedUrl.isEmpty {
+            return ("未配置地址", .secondaryLabel)
+        }
+        if !self.bridge.store.serviceEnabled {
+            return ("已暂停 · " + host, .secondaryLabel)
+        }
+        guard let status = self.bridge.status[subscription.id] else {
+            return ("连接中… · " + host, .systemOrange)
+        }
+        switch status.state {
+        case .connected:
+            return (status.detail + " · " + host, .systemGreen)
+        case .connecting:
+            return (status.detail + " · " + host, .systemOrange)
+        case .waiting:
+            return (status.detail, .systemRed)
+        case .disabled:
+            return (status.detail, .secondaryLabel)
+        }
+    }
+
+    @objc private func serviceSwitchChanged(_ sender: UISwitch) {
+        self.bridge.store.serviceEnabled = sender.isOn
+        self.bridge.start()
+        self.reload()
+    }
+
+    @objc private func keepAliveSwitchChanged(_ sender: UISwitch) {
+        self.bridge.store.keepAliveEnabled = sender.isOn
+        self.bridge.start()
+    }
+
+    private func sendTestNotification() {
+        UNUserNotificationCenter.current().getNotificationSettings(completionHandler: { settings in
+            DispatchQueue.main.async {
+                if settings.authorizationStatus == .denied {
+                    let alert = UIAlertController(title: "通知权限未开启", message: "请在系统设置中允许本 App 发送通知。", preferredStyle: .alert)
+                    alert.addAction(UIAlertAction(title: "取消", style: .cancel, handler: nil))
+                    alert.addAction(UIAlertAction(title: "去设置", style: .default, handler: { _ in
+                        if let url = URL(string: UIApplication.openSettingsURLString) {
+                            UIApplication.shared.open(url, options: [:], completionHandler: nil)
+                        }
+                    }))
+                    self.present(alert, animated: true, completion: nil)
+                } else {
+                    self.bridge.sendTestNotification()
+                }
+            }
+        })
+    }
+}
