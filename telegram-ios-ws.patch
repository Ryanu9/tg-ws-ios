index 00000000..bc955c53
--- /dev/null
+++ b/submodules/WsBridge/Sources/WsTarget.swift
@@ -0,0 +1,60 @@
+import Foundation
+
+/// Which local channel a frame lands in. Port of the Android `WsBridge.targetFor`.
+public struct WsTarget: Equatable {
+    public var channelId: Int64
+    public var title: String
+    /// Shown as post signature inside the shared (non-split) channel.
+    public var postAuthor: String?
+    public var split: Bool
+    public var text: String
+
+    /// Dialog routing: actions.bloggerName (or the 【name】 content prefix, resolved in WsParser)
+    /// wins over the raw sender; each distinct name gets its own channel
+    /// hash(subId + "|s:" + name). Without any name -> the subscription's own channel.
+    public static func make(subscription: WsSubscription, result: WsParser.Result) -> WsTarget {
+        var name: String?
+        if let blogger = result.blogger, !blogger.isEmpty {
+            name = WsParser.trim(blogger)
+        } else if let sender = result.sender {
+            name = WsParser.trim(sender)
+        }
+        if let current = name, current.count > 64 {
+            name = String(current.prefix(64))
+        }
+        let hasName = !(name ?? "").isEmpty
+        let split = subscription.splitBySender && hasName
+
+        let channelId = WsTarget.channelId(for: split ? subscription.id + "|s:" + (name ?? "") : subscription.id)
+        let title = split ? (name ?? "") : subscription.displayName
+        let postAuthor: String? = split ? nil : (hasName ? name : nil)
+
+        var text = result.text
+        if split, let name = name {
+            // "【Trader Bamp】\n..." is redundant inside the Trader Bamp channel
+            let prefix = "【" + name + "】"
+            let tt = WsParser.trim(text)
+            if tt.hasPrefix(prefix) {
+                let rest = WsParser.trim(String(tt.dropFirst(prefix.count)))
+                if !rest.isEmpty {
+                    text = rest
+                }
+            }
+        }
+        return WsTarget(channelId: channelId, title: title, postAuthor: postAuthor, split: split, text: text)
+    }
+
+    /// Stable channel id for a subscription (+ sender). Kept in the 2^30..2^31 range (same as Android).
+    public static func channelId(for key: String) -> Int64 {
+        var h: Int64 = 1125899906842597
+        for unit in key.utf16 {
+            h = 31 &* h &+ Int64(unit)
+        }
+        return 0x40000000 + ((h & 0x7fffffffffff) % 0x3fffffff)
+    }
+
+    /// Channel of a subscription when it is not split by sender.
+    public static func channelId(subscriptionId: String) -> Int64 {
+        return WsTarget.channelId(for: subscriptionId)
+    }
+}
